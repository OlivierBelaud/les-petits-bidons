{%- layout none -%}
{%- comment -%}
  LES-56 temporary read-only inventory: product template assignment per product.
  Render on preview theme only: /collections/all?view=les56-inventory&page=N
  An empty template_suffix means the product uses the default product.json template.
{%- endcomment -%}
{%- paginate collection.products by 250 -%}
{"page":{{ paginate.current_page | json }},"pages":{{ paginate.pages | json }},"total":{{ paginate.items | json }},"products":[
{%- for product in collection.products -%}
{"handle":{{ product.handle | json }},"title":{{ product.title | json }},"template_suffix":{{ product.template_suffix | default: '' | json }}}
{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]}
{%- endpaginate -%}
