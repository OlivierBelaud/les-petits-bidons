                      <div class="totals__subtotal-value text-lg-2xl font-bold leading-none tracking-tight">
                        {{ cart.total_price | money_with_currency }}
                      </div>
                    </div>
                  </div>
                {%- endif -%}

                {%- if cart != empty -%}
                  {%- if section.settings.show_checkout_button or section.settings.show_view_cart_button -%}
                    <form
                      action="{{ routes.cart_url }}"
                      method="POST"
                      novalidate
                      class="drawer__footer-buttons grid gap-4"
                    >
                      {%- if section.settings.show_checkout_button -%}
                        <a
                          class="button button--primary icon-with-text col-span-full cart-drawer__checkout-btn"
                          href="{{ routes.root_url }}checkout"
                          is="hover-button"
                          data-no-instant
                        >
                          <span class="btn-fill" data-fill></span>
                          <span class="btn-text">
                            {{- 'cart.general.checkout' | t -}}
                          </span>
                        </a>
                      {%- endif -%}

                      {%- if section.settings.show_view_cart_button -%}
                        <a
                          href="{{ routes.cart_url }}"
                          class="button button--secondary col-span-full"
                          is="hover-link"
                          data-no-instant
                        >
                          <span class="btn-fill" data-fill></span>
                          <span class="btn-text">{{ 'general.cart.view_cart' | t }}</span>
                        </a>
