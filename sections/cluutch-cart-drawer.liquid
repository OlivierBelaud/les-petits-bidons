{{ 'cluutch-cart-drawer.css' | asset_url | stylesheet_tag }}
{%- if request.page_type != 'cart' and settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer></script>
  {%- if linklists['gift-wrapping'].links != blank and linklists['gift-wrapping'].links.first.type == 'product_link' -%}
    <script src="{{ 'gift-wrapping.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <cart-drawer
    id="CartDrawer"
    class="cart-drawer drawer drawer--end z-35 fixed bottom-0 left-0 h-full w-full pointer-events-none"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'general.cart.title' | t | escape }}"
    data-section-id="{{ section.id }}"
    shopify-design-mode
    hidden
  >
    <overlay-element
      class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none"
      aria-controls="CartDrawer"
      aria-expanded="false"
    ></overlay-element>
    <div class="drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden">
      <gesture-element class="drawer__header flex justify-between items-center opacity-0 invisible relative">
        <div class="drawer__header-logo">
          {%- if settings.logo != blank -%}
            <a href="{{ routes.root_url }}" class="drawer__logo-link flex items-center">
              <span class="sr-only">{{ shop.name }}</span>
              {{ settings.logo | image_url: width: 240 | image_tag: loading: 'lazy', style: 'max-height: 40px; width: auto;', alt: shop.name }}
            </a>
          {%- else -%}
            <a href="{{ routes.root_url }}" class="drawer__logo-link h3">{{ shop.name }}</a>
          {%- endif -%}
        </div>

        <div
          class="cart-drawer__status"
          data-cart-drawer-status
          role="status"
          aria-live="polite"
          aria-atomic="true"
          hidden
        ></div>

        <div class="drawer__header-right flex items-center gap-8">
          <button
            class="drawer__tab relative"
            type="button"
            aria-controls="MiniCart-{{ section.id }}"
            aria-expanded="true"
          >
            <span class="drawer__title heading lg:text-3xl text-2xl leading-none tracking-tight">
              {{- 'general.cart.title' | t -}}
            </span>
            <cart-count
              class="count absolute font-medium text-xs lg:text-sm leading-none"
              aria-label="{{ 'general.cart.cart_count' | t: count: cart.item_count | escape }}"
              {% if cart == empty %}
                hidden
              {% endif %}
            >
              {{- cart.item_count -}}
            </cart-count>
          </button>

          <button
            class="button button--secondary button--close drawer__close flex items-center justify-center"
            type="button"
            is="hover-button"
            aria-controls="CartDrawer"
            aria-expanded="false"
            aria-label="{{ 'general.accessibility.close' | t | escape }}"
          >
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'close', size: 'sm' -%}
            </span>
          </button>
        </div>
      </gesture-element>

      <div class="drawer__content opacity-0 invisible flex flex-col h-full grow shrink">
        <div id="MiniCart-{{ section.id }}" class="drawer__panel opacity-0 flex flex-col overflow-hidden" open>
          <span class="sr-only">{{ 'general.cart.title' | t }}</span>
          <div class="flex flex-col h-full">
            {%- if cart == empty -%}
              {%- liquid
                assign empty_cart_custom_cards = section.blocks | where: 'type', 'empty_cart_card'
                assign empty_cart_collection_image_sizes = '(max-width: 767px) calc((100vw - 38px) / 2.5), 136px'
                assign empty_cart_product_image_sizes = '(max-width: 767px) calc((100vw - 38px) / 2), 136px'
                assign empty_cart_image_widths = '132,176,264,352,396,528,600'
              -%}
              <div class="drawer__scrollable cart-empty-state relative flex flex-col grow shrink">
                <h2 class="cart-empty-state__title heading leading-none tracking-tight text-center">
                  {{- section.settings.empty_cart_title | default: 'Votre panier est vide.' -}}
                </h2>

                {%- comment -%}
                  Sources hardcodees pour matcher les sections homepage:
                  - cluutch_collection_list_4AHLEm: blocs collection (tous-les-produits, lessive, vaisselle, bebe, ...)
                  - cluutch_featured_collections_63WKib: 1er bloc = best-sellers (produits)
                  Si la liste 'empty_cart_collections' est configuree dans le theme editor, elle prend le dessus.
                {%- endcomment -%}
                {%- liquid
                  assign essentials_handles_str = 'tous-les-produits-ecologiques-les-petits-bidons,lessive-les-petits-bidons,bebe-les-petits-bidons,vaisselle-les-petits-bidons,produit-menager-les-petits-bidons'
                  assign essentials_handles = essentials_handles_str | split: ','

                  assign essentials_collections = section.settings.empty_cart_collections
                  if essentials_collections == blank
                    assign essentials_collections = essentials_handles
                  endif
                -%}
                {%- if essentials_collections.size > 0 -%}
                  <div class="cart-empty-state__section">
                    {%- if section.settings.empty_cart_collections_heading != blank -%}
                      <p class="cart-empty-state__heading text-center">
                        {{- section.settings.empty_cart_collections_heading | escape -}}
                      </p>
                    {%- endif -%}
                    <div class="cart-empty-state__slider">
                      {%- for block in empty_cart_custom_cards -%}
                        <a
                          class="cart-empty-collection-card"
                          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                          {{ block.shopify_attributes }}
                        >
                          <div class="cart-empty-collection-card__media">
                            {%- if block.settings.image != blank -%}
                              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: empty_cart_collection_image_sizes, widths: empty_cart_image_widths, alt: '', class: 'cart-empty-collection-card__img' }}
                            {%- endif -%}
                            <span class="cart-empty-collection-card__arrow" aria-hidden="true">
                              {%- render 'icon', icon: 'arrow-right', size: 'xs' -%}
                            </span>
                          </div>
                          {%- if block.settings.title != blank -%}
                            <span class="cart-empty-collection-card__label">{{ block.settings.title | escape }}</span>
                          {%- endif -%}
                        </a>
                      {%- endfor -%}

                      {%- for entry in essentials_collections -%}
                        {%- liquid
                          if entry.url
                            assign col = entry
                          else
                            assign col = collections[entry]
                          endif
                        -%}
                        {%- if col != blank and col.url -%}
                          <a class="cart-empty-collection-card" href="{{ col.url }}">
                            <div class="cart-empty-collection-card__media">
                              {%- if col.image -%}
                                {{ col.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: empty_cart_collection_image_sizes, widths: empty_cart_image_widths, alt: '', class: 'cart-empty-collection-card__img' }}
                              {%- elsif col.products.first.featured_image -%}
                                {{ col.products.first.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: empty_cart_collection_image_sizes, widths: empty_cart_image_widths, alt: '', class: 'cart-empty-collection-card__img' }}
                              {%- endif -%}
                              <span class="cart-empty-collection-card__arrow" aria-hidden="true">
                                {%- render 'icon', icon: 'arrow-right', size: 'xs' -%}
                              </span>
                            </div>
                            <span class="cart-empty-collection-card__label">{{ col.title }}</span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}

                {%- liquid
                  assign best_sellers_products = section.settings.empty_cart_products
                  if best_sellers_products == blank
                    assign best_sellers_products = collections['best-sellers'].products
                  endif
                -%}
                {%- if best_sellers_products.size > 0 -%}
                  <div class="cart-empty-state__section">
                    {%- if section.settings.empty_cart_products_heading != blank -%}
                      <p class="cart-empty-state__heading text-center">
                        {{- section.settings.empty_cart_products_heading | escape -}}
                      </p>
                    {%- endif -%}
                    <div class="cart-empty-state__slider cart-empty-state__slider--products">
                      {%- for product in best_sellers_products limit: 12 -%}
                        {%- liquid
                          assign p_variant = product.selected_or_first_available_variant
                          assign p_on_sale = false
                          if p_variant.compare_at_price > p_variant.price
                            assign p_on_sale = true
                          endif
                          assign p_rating_value = product.metafields.reviews.rating.value
                          assign p_rating_count = product.metafields.reviews.rating_count.value
                          assign p_has_rating = false
                          if p_rating_value != blank and p_rating_count > 0
                            assign p_has_rating = true
                            assign p_rating_clean = p_rating_value | replace: ',', '.' | replace: ' ', '' | plus: 0 | round: 1
                          endif
                        -%}
                        <div class="cart-empty-product-card">
                          <a class="cart-empty-product-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                            {%- if product.featured_image -%}
                              {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: empty_cart_product_image_sizes, widths: empty_cart_image_widths, alt: '', class: 'cart-empty-product-card__img' }}
                            {%- endif -%}
                            <div class="cluutch-badges-wrapper">
                              {%- if p_variant.metafields.custom.label_texte != blank and p_variant.metafields.custom.label_color != blank -%}
                                <p class="cluutch-badge" style="background: {{ p_variant.metafields.custom.label_color }}; color: #ffffff;">{{ p_variant.metafields.custom.label_texte | escape }}</p>
                              {%- endif -%}
                              {%- if p_variant.metafields.custom.label_text_2 != blank and p_variant.metafields.custom.label_color_2 != blank -%}
                                <p class="cluutch-badge" style="background: {{ p_variant.metafields.custom.label_color_2 }}; color: #ffffff;">{{ p_variant.metafields.custom.label_text_2 | escape }}</p>
                              {%- endif -%}
                              {%- if p_variant.metafields.custom.cluutch_meilleure != blank -%}
                                <p class="cluutch-badge cluutch-badge--yellow">{{ p_variant.metafields.custom.cluutch_meilleure }}</p>
                              {%- endif -%}
                              {%- if p_variant.metafields.custom.cluutch_sans != blank -%}
                                <p class="cluutch-badge cluutch-badge--blue">{{ p_variant.metafields.custom.cluutch_sans }}</p>
                              {%- endif -%}
                              {%- if p_variant.metafields.custom.cluutch_lavande != blank -%}
                                <p class="cluutch-badge cluutch-badge--blue-lava">{{ p_variant.metafields.custom.cluutch_lavande }}</p>
                              {%- endif -%}
                              {%- if p_variant.metafields.custom.cluutch_fleurs != blank -%}
                                <p class="cluutch-badge cluutch-badge--orange">{{ p_variant.metafields.custom.cluutch_fleurs }}</p>
                              {%- endif -%}
                              {%- if p_variant.metafields.custom.cluutch_eucalyptus != blank -%}
                                <p class="cluutch-badge cluutch-badge--mint">{{ p_variant.metafields.custom.cluutch_eucalyptus }}</p>
                              {%- endif -%}
                            </div>
                          </a>
                          <div class="cart-empty-product-card__head">
                            <a href="{{ product.url }}" class="cart-empty-product-card__title">
                              {{- product.title | escape -}}
                            </a>
                            {%- if p_has_rating -%}
                              <div class="cart-empty-product-card__rating">
                                {% render 'cluutch-icon', icon: 'star' %}
                                <span>{{ p_rating_clean }} ({{ p_rating_count }})</span>
                              </div>
                            {%- endif -%}
                          </div>
                          <div class="cart-empty-product-card__price">
                            <span class="cart-empty-product-card__price-current">{{ p_variant.price | money }}</span>
                            {%- if p_on_sale -%}
                              <s class="cart-empty-product-card__price-compare">{{ p_variant.compare_at_price | money }}</s>
                            {%- endif -%}
                          </div>
                          <a href="{{ product.url }}" class="cart-empty-product-card__btn" is="hover-link">
                            Découvrir
                          </a>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}

              </div>
            {%- endif -%}
            <div class="drawer__scrollable relative flex flex-col gap-9 grow shrink{% if cart == empty %} hidden{% endif %}">
              {%- liquid
                if section.settings.show_free_shipping_bar and section.settings.free_shipping_minimum_amount != blank
                  assign minimum_amounts = section.settings.free_shipping_minimum_amount | remove: ' '
                  assign show_free_shipping_bar = false

                  if minimum_amounts contains ':'
                    assign minimum_amounts = minimum_amounts | split: ','
                    for amount in minimum_amounts
                      assign amount_parts = amount | split: ':'
                      assign currency_code = amount_parts | first | upcase
                      if currency_code == cart.currency.iso_code
                        assign minimum_amount = amount_parts | last
                        assign show_free_shipping_bar = true
                        break
                      endif
                    endfor
                  else
                    assign minimum_amount = minimum_amounts
                    assign show_free_shipping_bar = true
                  endif
                endif
              -%}

              {%- liquid
                if linklists['gift-wrapping'].links != blank and linklists['gift-wrapping'].links.first.type == 'product_link'
                  assign gift_wrapping = linklists['gift-wrapping'].links.first

                  assign gift_wrap_id = gift_wrapping.object.variants.first.id
                  assign gift_wraps_in_cart = 0
                  for item in cart.items
                    if item.id == gift_wrap_id
                      assign gift_wraps_in_cart = item.quantity
                      break
                    endif
                  endfor
                  assign items_in_cart = cart.item_count | minus: gift_wraps_in_cart
                endif
              -%}
              {%- if show_free_shipping_bar -%}
                <div class="cart-drawer__free-shipping-top">
                  {%- render 'free-shipping-bar', minimum_amount: minimum_amount -%}
                </div>
              {%- endif -%}

              <cart-items class="block grow" data-section-id="{{ section.id }}">
                <ul class="horizontal-products grid" role="list">
                  {%- for item in cart.items -%}
                    {%- liquid
                      assign is_gift_wrap_item = false

                      if gift_wrap_id != null and item.id == gift_wrap_id
                        assign is_gift_wrap_item = true
                      endif
                    -%}
                    {%- capture cart_item -%}
                      <li id="CartDrawer-Item-{{ item.key }}" style="gap:16px" class="horizontal-product flex items-start" data-variant-id="{{ item.variant_id }}" data-handle="{{ item.product.handle }}" data-quantity="{{ item.quantity }}" data-price="{{ item.original_price }}">
                        {%- if item.image -%}
                          <a class="horizontal-product__media media media--{{ settings.product_image_ratio }}{% unless settings.product_image_fill %} media--contain{% endunless %} relative overflow-hidden flex-auto" href="{{ item.url }}" tabindex="-1">
                            {{- item.image | image_url: width: item.image.width | image_tag: loading: 'lazy', widths: '180,360,540', is: 'lazy-image' -}}
                          </a>
                        {%- endif -%}
                        <div class="horizontal-product__details flex flex-col justify-start gap-1d5">

                              <div class="flex flex-col gap-1">
                                  <div class="flex flex-col gap-1">
                                  <div class="block leading-tight">
                                      {%- if item.product.metafields.reviews.rating.value != blank and item.product.metafields.reviews.rating_count.value > 0 -%}
                                        {% assign cart_rating = item.product.metafields.reviews.rating.value | replace: ',', '.' | replace: ' ', '' | plus: 0 | round: 1 %}
                                        <div class="flex items-center gap-1 text-xs" style="color: var(--mint-secondary, #007E7F);">
                                          {% render 'cluutch-icon', icon: 'star' %}
                                          <span>{{ cart_rating }}/5</span>
                                          <span style="color: var(--TEXT, #003435); opacity: 0.5;">({{ item.product.metafields.reviews.rating_count.value }})</span>
                                        </div>
                                      {%- endif -%}
                                      <a href="{{ item.url }}" class="horizontal-product__title reversed-link font-medium text-base leading-tight">{{ item.product.title | escape }}</a>
                                  </div>
                                  {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != null -%}
                                      <dl class="grid gap-1d5">
                                      {%- unless item.product.has_only_default_variant -%}
                                          {%- assign variant_inline = '' -%}
                                          {%- for option in item.options_with_values -%}
                                              {%- if option.value != 'x1' -%}
                                                  {%- assign option_display = option.value | split: '/' | first | strip -%}
                                                  {%- if variant_inline == '' -%}
                                                      {%- assign variant_inline = option_display -%}
                                                  {%- else -%}
                                                      {%- assign variant_inline = variant_inline | append: ' / ' | append: option_display -%}
                                                  {%- endif -%}
                                              {%- endif -%}
                                          {%- endfor -%}
                                          {%- if variant_inline != '' -%}
                                              <div class="text-xs text-opacity leading-tight">{{ variant_inline }}</div>
                                          {%- endif -%}
                                      {%- endunless -%}
              
                                      {%- for property in item.properties -%}
                                          {%- assign property_first_char = property.first | slice: 0 -%}
                                          {%- if property.last != blank and property_first_char != '_' -%}
                                              
                                          <div class="flex gap-1 text-xs text-opacity leading-tight">
                                              <dt>{{ property.first }}:&nbsp;</dt>
                                              <dd>
                                              {%- if property.last contains '/uploads/' -%}
                                                  <a href="{{ property.last }}" class="link" target="_blank" aria-describedby="a11y-new-window-message">
                                                  {{- property.last | split: '/' | last -}}
                                                  </a>
                                              {%- else -%}
                                                  {{- property.last | split: '/' | first | strip -}}
                                              {%- endif -%}
                                              </dd>
                                          </div>
                                          {%- endif -%}
                                      {%- endfor -%}
                                      </dl>
                                  {%- endif -%}
                                  </div>
                                  <div class="cart-item__bottom">
                                    <div class="flex flex-col gap-1">
                                            <div class="cart-product__content">
                                              {%- liquid
                                                assign has_shopify_sale = false
                                                if item.variant.compare_at_price > item.variant.price
                                                  assign has_shopify_sale = true
                                                endif
                                              -%}
                                              <div class="cart-item__price-row flex items-end justify-between gap-3 w-full">
                                              <div class="price{% if item.original_price != item.final_price or has_shopify_sale %} price--on-sale{% endif %} text-sm flex flex-wrap items-center gap-1d5">
                                                  {%- liquid
                                                  assign money_price = item.original_price | times: item.quantity | money
                                                  if settings.currency_code_enabled
                                                      assign money_price = item.original_price| money_with_currency
                                                  endif
                                                  -%}
                                                  {%- if item.original_price != item.final_price -%}
                                                      <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
                                                      <span class="price__regular whitespace-nowrap">
                                                          <strong>
                                                            {%- liquid
                                                            if settings.currency_code_enabled
                                                                echo item.final_price | times: item.quantity | money_with_currency
                                                            else
                                                                echo item.final_price | times: item.quantity | money
                                                            endif
                                                            -%}
                                                          </strong>
                                                      </span>
                                                      <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
                                                      <span class="price__sale inline-flex items-center relative">
                                                        {% comment %} {{ money_price }} {% endcomment %}
                                                        {{ item.variant.price | times: item.quantity | money }}
                                                      </span>
                                                  {%- elsif has_shopify_sale -%}
                                                      <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
                                                      <span class="price__regular whitespace-nowrap">
                                                          <strong>
                                                            {%- if settings.currency_code_enabled -%}
                                                              {{ item.final_price | times: item.quantity | money_with_currency }}
                                                            {%- else -%}
                                                              {{ item.final_price | times: item.quantity | money }}
                                                            {%- endif -%}
                                                          </strong>
                                                      </span>
                                                      <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
                                                      <span class="price__sale inline-flex items-center relative">
                                                        {{ item.variant.compare_at_price | times: item.quantity | money }}
                                                      </span>
                                                  {% elsif item.original_price != item.variant.price %}
                                                              <strong>
                                                          {{- money_price -}}
                                                              </strong>

                                                      <span class="price__sale inline-flex items-center relative">{{ item.variant.price | times: item.quantity | money }}</span>
                                                      {%- else -%}
                                                      <strong>
                                                      {{- money_price -}}
                                                          </strong>

                                                  {%- endif -%}

                                                  {%- if has_shopify_sale -%}
                                                    {%- assign shopify_diff = item.variant.compare_at_price | minus: item.variant.price -%}
                                                    {%- assign shopify_pct = shopify_diff | times: 100.0 | divided_by: item.variant.compare_at_price -%}
                                                    <span class="cluutch-badge badge badge--highlight flex items-center gap-1d5 font-medium leading-none rounded-full">
                                                      Promo : -{{ shopify_pct | round }}%
                                                    </span>
                                                  {%- elsif item.line_level_discount_allocations != blank -%}
                                                    {%- assign promo_pct = 0 -%}
                                                    {%- for discount in item.discount_allocations -%}
                                                      {%- assign discount_title = discount.discount_application.title | downcase -%}
                                                      {%- assign show_promo_badge = true -%}
                                                      {%- if discount_title contains 'quantité' or discount_title contains 'abonnement' or discount_title contains 'lot' -%}
                                                        {%- assign show_promo_badge = false -%}
                                                      {%- endif -%}
                                                      {%- if show_promo_badge and discount.discount_application.value_type == "percentage" -%}
                                                        {%- assign promo_pct = promo_pct | plus: discount.discount_application.value -%}
                                                      {%- endif -%}
                                                    {%- endfor -%}
                                                    {%- if promo_pct > 0 -%}
                                                      <span class="cluutch-badge badge badge--highlight flex items-center gap-1d5 font-medium leading-none rounded-full">
                                                        Promo : -{{ promo_pct | round }}%
                                                      </span>
                                                    {%- endif -%}
                                                  {%- endif -%}

                                                  {%- if item.selling_plan_allocation != null and has_shopify_sale == false -%}
                                                    {%- assign sp_name = item.selling_plan_allocation.selling_plan.name
                                                      | replace: 'Livraison tous les 1', 'Livré tous les'
                                                      | replace: 'Livraison tous les', 'Livré tous les'
                                                      | replace: 'Months', 'Mois'
                                                      | replace: 'Month', 'Mois'
                                                      | remove: ','
                                                    -%}
                                                    <span class="cluutch-badge badge badge--highlight flex items-center gap-1d5 font-medium leading-none rounded-full">
                                                      {{ sp_name }} (-{{ item.selling_plan_allocation.selling_plan.price_adjustments.first.value }}%)
                                                    </span>
                                                  {%- endif -%}

                                                  {%- if item.variant.available and item.unit_price_measurement -%}
                                                    <span class="sr-only">{{ 'products.price.unit_price' | t }}</span>
                                                    <span class="unit-price flex items-center">
                                                        {%- liquid
                                                          capture unit_price_base_unit
                                                            if item.variant.unit_price_measurement
                                                            if item.variant.unit_price_measurement.reference_value != 1
                                                                echo item.variant.unit_price_measurement.reference_value
                                                            endif
                                                            echo item.variant.unit_price_measurement.reference_unit
                                                            endif
                                                        endcapture
                                                        -%}
                                                        ({{ item.variant.unit_price | money }}
                                                        <span aria-hidden="true">/</span>
                                                        <span class="sr-only">&nbsp;{{ 'general.accessibility.unit_price_separator' | t }}&nbsp;</span>
                                                        {{ unit_price_base_unit }})
                                                    </span>
                                                  {%- endif -%}


                                              </div>
                          {%- liquid
                            assign has_qty_rules = false
                            if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                              assign has_qty_rules = true
                            endif
      
                            assign has_vol_pricing = false
                            if item.variant.quantity_price_breaks.size > 0
                              assign has_vol_pricing = true
                            endif
                          -%}
                          {%- if has_qty_rules or has_vol_pricing -%}
                            {%- capture qty_rules_vol_pricing -%}
                              {%- if has_qty_rules -%}
                                <div class="quantity__rules text-sm font-medium leading-tight">
                                  {%- if item.variant.quantity_rule.increment > 1 -%}
                                    <span class="divider">
                                      {{- 'products.quantity.multiples_of' | t: quantity: item.variant.quantity_rule.increment -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.min > 1 -%}
                                    <span class="divider">
                                      {{- 'products.quantity.min_of' | t: quantity: item.variant.quantity_rule.min -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.max != null -%}
                                    <span class="divider">
                                      {{- 'products.quantity.max_of' | t: quantity: item.variant.quantity_rule.max -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                              {%- endif -%}
                              {%- if has_vol_pricing -%}
                                {{ 'volume-pricing.css' | asset_url | stylesheet_tag }}
                                <volume-pricing class="volume-pricing grid gap-6">
                                  <span class="caption-large font-medium">{{ 'products.volume_pricing.title' | t }}</span>
                                  <ul class="list-unstyled">
                                    <li class="text-sm flex gap-2d5 justify-between">
                                      <span class="font-medium">{{ item.variant.quantity_rule.min }}+</span>
                                      {%- assign price = item.variant.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                    {%- for price_break in item.variant.quantity_price_breaks -%}
                                      <li class="text-sm flex gap-2d5 justify-between">
                                        <span class="font-medium">
                                          {{- price_break.minimum_quantity -}}
                                          <span aria-hidden="true">+</span>
                                        </span>
                                        {%- assign price = price_break.price | money_with_currency -%}
                                        <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </volume-pricing>
                              {%- endif -%}
                            {%- endcapture -%}
                          {%- endif -%}
                          <div class="flex flex-col-reverse items-end gap-3">
                            {%- unless is_gift_wrap_item -%}
                              <div class="cart-quantity__info flex items-center gap-3 shrink-0">
                                {%- if has_qty_rules or has_vol_pricing -%}
                                  <button type="button" class="hotspot hidden md:flex items-center justify-end relative cursor-pointer">
                                    {%- render 'icon', icon: 'info', size: 'lg' -%}
                                    <div class="hotspot__content grid gap-6 items-center absolute z-1 pointer-events-none overflow-hidden text-left">
                                      {{- qty_rules_vol_pricing -}}
                                    </div>
                                  </button>
                                  <button type="button" class="md:hidden flex items-center justify-center" aria-controls="VolumePricing-{{ section.id }}-{{ item.key }}" aria-expanded="false">
                                    {%- render 'icon', icon: 'info', size: 'sm' -%}
                                  </button>
                                  <x-modal id="VolumePricing-{{ section.id }}-{{ item.key }}" class="x-modal drawer z-35 fixed bottom-0 left-0 h-full w-full pointer-events-none"
                                    role="dialog"
                                    aria-modal="true"
                                    aria-label="{{ item.product.title | escape }}"
                                    hidden
                                  >
                                    <overlay-element class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none" aria-controls="VolumePricing-{{ section.id }}-{{ item.key }}" aria-expanded="false"></overlay-element>
                                    <div class="drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden">
                                      <gesture-element class="drawer__header flex justify-between opacity-0 invisible relative">
                                        <span class="drawer__title heading title-md grid gap-4">
                                          {{ item.product.title | escape }}
                                          {%- unless item.product.has_only_default_variant -%}
                                            <dl class="grid gap-1d5">
                                              
                                              {%- for option in item.options_with_values -%}

                                                <div class="flex gap-1 text-xs text-opacity leading-tight">
                                                  <dt class="sr-only">{{ option.name }}:</dt>
                                                  <dd>{{ option.value }}</dd>
                                                </div>
                                              {%- endfor -%}
                                            </dl>
                                          {%- endunless -%}
                                        </span>
                                        <button class="button button--secondary button--close drawer__close hidden sm:flex items-center justify-center" type="button" is="hover-button" aria-controls="VolumePricing-{{ section.id }}-{{ item.key }}" aria-expanded="false" aria-label="{{ 'general.accessibility.close' | t | escape }}">
                                          <span class="btn-fill" data-fill></span>
                                          <span class="btn-text">
                                            {%- render 'icon', icon: 'close', size: 'sm' -%}
                                          </span>
                                        </button>
                                      </gesture-element>
                                      <div class="drawer__content opacity-0 invisible flex flex-col h-full grow shrink">
                                        <div class="drawer__scrollable relative flex flex-col gap-5 md:gap-7 grow shrink">
                                          <div class="text-base md:text-lg grid gap-6">
                                            {{- qty_rules_vol_pricing -}}
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  </x-modal>
                                {%- endif -%}
                                <quantity-input class="cart-qty-pill flex items-center" data-item-key="{{ item.key }}">
                                  <label class="sr-only" for="Quantity-{{ section.id }}-{{ item.key }}">
                                    {{- 'products.quantity.label' | t -}}
                                  </label>
                                  <button type="button" name="minus" class="cart-qty-pill__btn cart-qty-pill__minus" aria-label="{{ 'products.quantity.decrease' | t: product: item.product.title | escape }}">
                                    <span class="cart-qty-pill__btn-content">
                                      <span class="quantity__minus-icon{% if item.quantity <= 1 %} hidden{% endif %}">−</span>
                                      <span class="quantity__trash-icon{% if item.quantity > 1 %} hidden{% endif %}">{%- render 'icon', icon: 'trash', size: 'sm' -%}</span>
                                    </span>
                                    <span class="cart-qty-pill__loader hidden">{%- render 'icon', icon: 'rotator', size: 'xs', class: 'animate-rotator' -%}</span>
                                  </button>
                                  <input class="cart-qty-pill__input"
                                    type="number"
                                    name="updates[]"
                                    aria-label="{{ 'products.quantity.input_label' | t: product: item.product.title | escape }}"
                                    id="Quantity-{{ section.id }}-{{ item.key }}"
                                    data-index="{{ item.key }}"
                                    inputmode="numeric"
                                    autocomplete="off"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                    min="0"
                                    data-min="{{ item.variant.quantity_rule.min }}"
                                    {% if item.variant.quantity_rule.max != null %}
                                      max="{{ item.variant.quantity_rule.max }}"
                                    {% endif %}
                                    step="{{ item.variant.quantity_rule.increment }}"
                                    value="{{ item.quantity }}"
                                  />
                                  <button type="button" name="plus" class="cart-qty-pill__btn" aria-label="{{ 'products.quantity.increase' | t: product: item.product.title | escape }}">
                                    <span class="cart-qty-pill__btn-content">+</span>
                                    <span class="cart-qty-pill__loader hidden">{%- render 'icon', icon: 'rotator', size: 'xs', class: 'animate-rotator' -%}</span>
                                  </button>
                                </quantity-input>
                                <script>
                                  (function() {
                                    var input = document.getElementById('Quantity-{{ section.id }}-{{ item.key }}');
                                    if (!input) return;
                                    function updateIcon() {
                                      var qty = parseInt(input.value) || 0;
                                      var pill = input.closest('.cart-qty-pill');
                                      if (!pill) return;
                                      var minusIcon = pill.querySelector('.quantity__minus-icon');
                                      var trashIcon = pill.querySelector('.quantity__trash-icon');
                                      if (minusIcon && trashIcon) {
                                        if (qty <= 1) {
                                          minusIcon.classList.add('hidden');
                                          trashIcon.classList.remove('hidden');
                                        } else {
                                          minusIcon.classList.remove('hidden');
                                          trashIcon.classList.add('hidden');
                                        }
                                      }
                                    }
                                    input.addEventListener('change', updateIcon);
                                    var observer = new MutationObserver(function() { updateIcon(); });
                                    observer.observe(input, { attributes: true, attributeFilter: ['value'] });
                                  })();
                                </script>
                              </div>
                            {%- else -%}
                              <div class="cart-quantity flex items-center relative">
                                <label class="sr-only" for="Quantity-{{ section.id }}-{{ item.key }}">
                                  {{- 'products.quantity.label' | t -}}
                                </label>
                                <input class="quantity__input input text-center w-full h-full"
                                  type="number"
                                  name="updates[]"
                                  aria-label="{{ 'products.quantity.input_label' | t: product: item.product.title | escape }}"
                                  id="Quantity-{{ section.id }}-{{ item.key }}"
                                  data-index="{{ item.key }}"
                                  inputmode="numeric"
                                  autocomplete="off"
                                  data-quantity-variant-id="{{ item.variant.id }}"
                                  data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                  min="0"
                                  data-min="{{ item.variant.quantity_rule.min }}"
                                  {% if item.variant.quantity_rule.max != null %}
                                    max="{{ item.variant.quantity_rule.max }}"
                                  {% endif %}
                                  step="{{ item.variant.quantity_rule.increment }}"
                                  value="{{ item.quantity }}"
                                  disabled
                                />
                                <div class="quantity__buttons absolute right-0 hidden lg:flex flex-col items-center justify-center h-full sr-only">
                                  <button type="button" name="plus" class="quantity__button flex justify-center w-full items-end" aria-label="{{ 'products.quantity.increase' | t: product: item.product.title | escape }}" disabled>
                                    {%- render 'icon', icon: 'increase', size: 'sm', class: 'stroke-1' -%}
                                  </button>
                                  <button type="button" name="minus" class="quantity__button flex justify-center w-full items-start" aria-label="{{ 'products.quantity.decrease' | t: product: item.product.title | escape }}" disabled>
                                    {%- render 'icon', icon: 'decrease', size: 'sm', class: 'stroke-1' -%}
                                  </button>
                                </div>
                              </div>
                            {%- endunless -%}
                            <div class="text-xs text-right relative">
                              <a class="link" href="{{ item.url_to_remove }}"{% unless is_gift_wrap_item %} is="cart-remove-button"{% else %} is="remove-gift-wrap"{% endunless %} data-index="{{ item.key }}" data-no-instant hidden>{{ 'cart.general.remove' | t }}</a>
                            </div>
                          </div>
                                              </div>

                                            </div>
                                    </div>
                                  
                                  <div>
                                    

                                
                              </div>
                              </div>
                              </div>
                          </div>
                              <style>
                                  .badge.cluutch-badge{
                                      background: #E3F8F6; 
                                      border-radius: 32px;
                                      font-size: 12px;
                                      padding-inline: 12px !important;
                                      width: fit-content;
                                  }
                              </style>
                      </li>
              {%- endcapture -%}
                    {%- liquid
                      unless is_gift_wrap_item
                        echo cart_item
                      else
                        assign cart_gift_wrap_item = cart_item
                      endunless
                    -%}
                  {%- endfor -%}

                  {%- liquid
                    if cart_gift_wrap_item
                      echo cart_gift_wrap_item
                    endif
                  -%}
                </ul>
              </cart-items>

              {%- render 'gift-wrapping',
                section_id: section.id,
                gift_wrapping: gift_wrapping,
                gift_wrap_id: gift_wrap_id,
                gift_wraps_in_cart: gift_wraps_in_cart,
                items_in_cart: items_in_cart
              -%}

              {%- if cart != empty and section.settings.cart_recommendations_enabled -%}
                {%- liquid
                  assign first_product_id = cart.items.first.product_id
                  if cart_gift_wrap_item
                    if first_product_id == gift_wrapping.object.id
                      if cart.items.size > 1
                        assign first_product_id = cart.items[1].product_id
                      endif
                    endif
                  endif
                -%}
                {%- render 'cluutch-product-complementary',
                  section_id: section.id,
                  product_id: first_product_id,
                  image_ratio: settings.product_image_ratio,
                  image_fill: settings.product_image_fill,
                  limit: section.settings.cart_recommendations_limit,
                  heading: section.settings.cart_recommendations_heading,
                  show_vendor: section.settings.show_cart_recommendations_vendor,
                  show_price: section.settings.show_cart_recommendations_price,
                  recommendations_products: section.settings.cart_recommendations_products
                -%}
                <div class="icon-block__wrapper">
                  {% for block in section.blocks %}
                    {% case block.type %}
                      {% when 'image' %}
                        <div class="icon-block">
                          {% if block.settings.icon != blank %}
                            {{
                              block.settings.icon
                              | image_url: width: master
                              | image_tag: loading: loading, is: 'lazy-image', class: 'icon-block__image'
                            }}
                            <p class="icon-block__text">
                              {{ block.settings.text }}
                            </p>
                          {% endif %}
                        </div>
                    {% endcase %}
                  {% endfor %}
                </div>
              {%- endif -%}
            </div>
            {% for block in section.blocks %}
              {% case block.type %}
                {% when '@app' %}
                  {% render block %}
              {% endcase %}
            {% endfor %}

            <!-- Judge.me rating moved to footer bottom -->
            <div class="drawer__footer grid w-full">
              {%- if section.settings.show_cart_note or section.settings.show_shipping_calculator -%}
                <div class="drawer__footer-top flex">
                  {%- if section.settings.show_cart_note -%}
                    <button
                      type="button"
                      class="flex gap-2d5 grow items-center justify-center"
                      aria-controls="CartNote-{{ section.id }}"
                      aria-expanded="false"
                    >
                      {%- render 'icon', icon: 'note', size: 'lg', class: 'icon-light flex-auto' -%}
                      <span class="reversed-link text-sm leading-tight">{{ 'general.cart.note.title' | t }}</span>
                    </button>
                  {%- endif -%}
                  {%- if section.settings.show_shipping_calculator -%}
                    <button
                      type="button"
                      class="flex gap-2d5 grow items-center justify-center"
                      aria-controls="ShippingCalculator-{{ section.id }}"
                      aria-expanded="false"
                    >
                      {%- render 'icon', icon: 'package', size: 'lg', class: 'icon-light flex-auto' -%}
                      <span class="reversed-link text-sm leading-tight">
                        {{- 'general.cart.shipping_calculator.title' | t -}}
                      </span>
                    </button>
                  {%- endif -%}

                  {%- if section.settings.show_cart_note -%}
                    <modal-element
                      id="CartNote-{{ section.id }}"
                      class="modal invisible absolute bottom-0 left-0 w-full h-full"
