                      href="{{ routes.all_products_collection_url }}"
                      class="button button--primary icon-with-text col-span-full cart-drawer__checkout-btn"
                      is="hover-link"
                      data-no-instant
                    >
                      <span class="btn-fill" data-fill></span>
                      <span class="btn-text">Continuer mon shopping</span>
