                              | image_tag: class: 'size-discount-icon'
                            }}
                          {% endif %}
                        </button>
                      {% endfor %}
                    </div>
                  </div>

                  <div class="product-quantity__container">
                    <div class="product-quantity-options">
                      {% for block in section.blocks %}
                        {% case block.type %}
                          {% when 'quantity-button' %}
                            {% assign item = block.settings %}
                            {% assign quantity = item.value | default: 1 %}
                            {% assign raw_discount = item.discount | remove: '%' | remove: '-' %}
                            {% assign discount_percent = raw_discount | default: 0 %}
                            {% assign discount_rate = discount_percent | divided_by: 100.0 %}
                            {% assign unit_price_cents = product.selected_or_first_available_variant.price %}
                            {% assign discount_multiplier = 1.0 | minus: discount_rate %}
                            {% assign discounted_price_raw = unit_price_cents | times: discount_multiplier %}

                            {% assign discounted_price_cents_int = discounted_price_raw | floor %}
                            {% assign decimal_part = discounted_price_raw | minus: discounted_price_cents_int %}
                            {% if decimal_part > 0 %}
                              {% assign discounted_unit_price_cents = discounted_price_cents_int | plus: 1 %}
                            {% else %}
                              {% assign discounted_unit_price_cents = discounted_price_cents_int %}
                            {% endif %}

                            {% assign total_price_cents = discounted_unit_price_cents | times: quantity %}
                            {% assign total_price_eur = total_price_cents | divided_by: 100.0 %}
                            {% assign compare_price_eur = unit_price_cents | times: quantity | divided_by: 100.0 %}

                            <div class="product-quantity__button">
                              <input
                                type="hidden"
                                data-price="{{ total_price_eur | round: 2 }}"
                                data-compare="{{ compare_price_eur | round: 2 }}"
                                class="data-main-price"
                              >

                              <input
                                type="radio"
                                name="quantity"
                                data-debug-price="{{ unit_price_cents | divided_by: 100.0 }}"
                                data-debug-discount="{{ discount_percent }}"
                                data-debug-calc="{{ discounted_unit_price_cents | divided_by: 100.0 }}"
                                data-label="{{ item.discount_label }}"
                                data-discount="{{ item.discount }}"
                                value="{{ item.value }}"
                                id="quantity-{{ forloop.index }}"
                                {% if item.value == '1' %}
                                  checked
                                {% endif %}
                              >
                              <label for="quantity-{{ forloop.index }}">
                                <p class="product-quantity__discont">{{ item.discount }}</p>
                                {{ item.text }}
                                {{ item.image | image_url: width: master | image_tag: class: 'size-discount-icon' }}
                              </label>
                            </div>
                        {% endcase %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
