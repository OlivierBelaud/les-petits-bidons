                          <div class="details__content rte text-sm text-opacity">
                            {{ variant.metafields.custom.cluutch_content_text_third | metafield_tag }}
                          </div>
                        </details>
                      {% endif %}

                      {% if variant.metafields.custom.cluutch_content_text_fourth != blank %}
                        <details class="product__accordion details">
                          <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                            <div class="flex items-center gap-2d5">
                              Et pour la planète ?
                              <span class="product-contenu-icone"> 🌎 </span>
                            </div>
                          </summary>
                          <div class="details__content rte text-sm text-opacity">
                            {{ variant.metafields.custom.cluutch_content_text_fourth | metafield_tag }}
                          </div>
                        </details>
                      {% endif %}
                    {% endfor %}
                  {% endcomment %}
                  {%- assign current_variant = product.selected_or_first_available_variant -%}

                  {% if current_variant.metafields.custom.cluutch_content_text != blank %}
                    <details
                      data-handle="{{ related_product.handle }}"
                      class="product__accordion details"
                      is="accordion-details"
                      {{ block.shopify_attributes }}
                      class="product__accordion details"
                    >
                      <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                        <div class="flex items-center gap-2d5">
                          Descriptif
                          <span class="product-contenu-icone"> 🙌 </span>
                        </div>
                      </summary>
                      <div class="details__content rte text-sm text-opacity">
                        {{ current_variant.metafields.custom.cluutch_content_text | metafield_tag }}
                      </div>
                    </details>
                  {% endif %}

                  {% if current_variant.metafields.custom.cluutch_content_text_second != blank %}
                    <details class="product__accordion details">
                      <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                        <div class="flex items-center gap-2d5">
                          Ingrédients naturels
                          <span class="product-contenu-icone"> 🌱 </span>
                        </div>
                      </summary>
                      <div class="details__content rte text-sm text-opacity">
                        {{ current_variant.metafields.custom.cluutch_content_text_second | metafield_tag }}
                      </div>
                    </details>
                  {% endif %}

                  {% if current_variant.metafields.custom.cluutch_content_text_third != blank %}
                    <details class="product__accordion details">
                      <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                        <div class="flex items-center gap-2d5">
                          Utilisation
                          <span class="product-contenu-icone"> 💦 </span>
                        </div>
                      </summary>
                      <div class="details__content rte text-sm text-opacity">
                        {{ current_variant.metafields.custom.cluutch_content_text_third | metafield_tag }}
                      </div>
                    </details>
                  {% endif %}

                  {% if current_variant.metafields.custom.cluutch_content_text_fourth != blank %}
                    <details class="product__accordion details">
                      <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                        <div class="flex items-center gap-2d5">
                          Et pour la planète ?
                          <span class="product-contenu-icone"> 🌎 </span>
                        </div>
                      </summary>
                      <div class="details__content rte text-sm text-opacity">
                        {{ current_variant.metafields.custom.cluutch_content_text_fourth | metafield_tag }}
                      </div>
                    </details>
                  {% endif %}
                {% endif %}
              </div>

            {%- when 'countdown' -%}
              {%- if product.metafields.theme.countdown.value != blank -%}
                {%- liquid
                  assign now_time = 'now' | date: '%s' | times: 1
                  assign countdown_time = product.metafields.theme.countdown.value | date: '%s' | times: 1
                -%}
                {%- if countdown_time > now_time -%}
                  <div
                    class="product-countdown grid sm:flex items-center justify-between gap-2d5"
                    id="shopify-block-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="flex items-center gap-3">
                      {%- render 'icon', icon: 'countdown', size: 'xl', class: 'flex-auto block lg:hidden xl:block' -%}
                      <div class="grid">
                        {%- if block.settings.heading != blank -%}
                          <p class="heading text-base lg:text-lg xl:text-xl leading-tight">
                            {{ block.settings.heading | escape }}
                          </p>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="uppercase text-3xs font-medium leading-none tracking-widest">
                            {{ block.settings.subheading | escape }}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                    <countdown-timer
                      class="countdown__timer flex text-center"
                      data-expires="{{ product.metafields.theme.countdown.value | date: '%FT%T%:z' | escape }}"
                    >
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.days' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.hours' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.minutes' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.seconds' | t }}</span>
                      </div>
                    </countdown-timer>
                    <style>
                      #shopify-block-{{ block.id }} {
                        {%- render 'section-variables', section: block -%}
                      }
                    </style>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {% when 'icons' %}
              <div class="cluutch-main-product__flex">
                {% for i in (1..4) %}
                  {% assign icon_setting = 'icon_' | append: i %}
                  {% assign text_setting = 'text_' | append: i %}

                  {% unless block.settings[icon_setting] == blank and block.settings[text_setting] == blank %}
                    <div class="cluutch-main-product__flex-content">
                      {{ block.settings[icon_setting] }}
                      <p>{{ block.settings[text_setting] }}</p>
                    </div>
                  {% endunless %}
                {% endfor %}
              </div>
            {%- when 'back_in_stock' -%}
              <div
                id="BackInStock-{{ section.id }}-{{ product.id }}"
                class="back-in-stock"
                {{ block.shopify_attributes }}
              >
                {%- liquid
                  assign check_against_inventory = true
                  if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                    assign check_against_inventory = false
                  endif
                  if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                    assign quantity_rule_soldout = true
                  endif

                  if product.selected_or_first_available_variant.available == false or quantity_rule_soldout
                    render 'back-in-stock', product: product, product_id: product.id, section_id: section.id, heading: block.settings.heading, description: block.settings.description, compact: true
                  endif
                -%}
              </div>

            {%- when 'line_item_property' -%}
              {%- assign custom_name = block.settings.title | escape -%}
              <div class="field" {{ block.shopify_attributes }}>
                {%- if block.settings.type == 'checkbox' -%}
                  <label
                    for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                    class="flex items-center gap-3"
                  >
                    <input
                      type="hidden"
                      name="properties[{{ custom_name }}]"
                      form="{{ product_form_id }}"
                      value="{{ block.settings.unchecked_value | escape }}"
                    >
                    <input
                      type="checkbox"
                      id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      name="properties[{{ custom_name }}]"
                      form="{{ product_form_id }}"
                      value="{{ block.settings.checked_value | escape }}"
                      {%- if block.settings.required %}
                        required
                      {% endif -%}
                    >
                    {{- block.settings.title | escape -}}
                  </label>

                {%- elsif block.settings.type == 'radio' -%}
                  <div class="grid gap-4">
                    <p>{{ block.settings.title | escape }}</p>
                    {%- assign options = block.settings.radio_options | split: ',' -%}
                    {%- if options.size > 0 -%}
                      <ul class="grid gap-2 leading-none" role="list">
                        {%- for option in options -%}
                          {%- assign option_2 = option | strip | escape -%}
                          <li>
                            <label
                              for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}-{{ forloop.index0 }}"
                              class="inline-flex items-center gap-3"
                            >
                              <input
                                type="radio"
                                id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}-{{ forloop.index0 }}"
                                name="properties[{{ custom_name }}]"
                                form="{{ product_form_id }}"
                                value="{{ option_2 }}"
                                {%- if block.settings.required %}
                                  required
                                {% endif -%}
                              >
                              {{- option_2 -}}
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                {%- else -%}
                  {%- case block.settings.type -%}
                    {%- when 'text' -%}
                      <input
                        class="input is-floating"
                        type="text"
                        id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                        name="properties[{{ custom_name }}]"
                        form="{{ product_form_id }}"
                        placeholder="{{ block.settings.title | escape }}"
                        {%- if block.settings.required %}
                          required
                        {% endif -%}
                      >
                      <label
                        class="label is-floating"
                        for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      >
                        {{- block.settings.title | escape -}}
                      </label>

                    {%- when 'textarea' -%}
                      <textarea
                        class="textarea is-floating"
                        rows="5"
                        id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                        name="properties[{{ custom_name }}]"
                        form="{{ product_form_id }}"
                        placeholder=" "
                        {%- if block.settings.required %}
                          required
                        {% endif -%}
                      ></textarea>
                      <label
                        class="label is-floating"
                        for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      >
                        {{- block.settings.title | escape -}}
                      </label>

                    {%- when 'select' -%}
                      {%- assign options = block.settings.select_options | split: ',' -%}
                      {%- if options.size > 0 -%}
                        <select
                          class="select is-floating"
                          id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                          name="properties[{{ custom_name }}]"
                          form="{{ product_form_id }}"
                          {%- if block.settings.required %}
                            required
                          {% else %}
                            is="custom-select"
                          {% endif -%}
                        >
                          <option value="" disabled selected></option>
                          {%- for option in options -%}
                            {%- assign option_2 = option | strip | escape -%}
                            <option value="{{ option_2 }}">{{ option_2 }}</option>
                          {%- endfor -%}
                        </select>
                        {%- render 'icon', icon: 'chevron-up', size: 'sm', class: 'absolute' -%}
                      {%- endif -%}
                      <label
                        class="label{% if options.size > 0 %} is-floating{% endif %}"
                        for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      >
                        {{- block.settings.title | escape -}}
                      </label>
                  {%- endcase -%}
                {%- endif -%}
              </div>

          {%- when 'lpb-scrolling-banner' -%}
            {%- liquid
              assign show_lpb_banner = true

              if block.settings.enable_schedule
                assign now_utc = 'now' | date: '%s' | plus: 0
                assign paris_offset = 3600
                assign now_paris = now_utc | plus: paris_offset

                if block.settings.start_date != blank
                  assign start_parts = block.settings.start_date | split: '/'
                  assign start_date_iso = start_parts[2] | append: '-' | append: start_parts[1] | append: '-' | append: start_parts[0]
                  assign start_datetime = start_date_iso | append: ' ' | append: block.settings.start_time
                  assign start_timestamp = start_datetime | date: '%s' | plus: 0
                  if now_paris < start_timestamp
                    assign show_lpb_banner = false
                  endif
                endif

                if block.settings.end_date != blank
                  assign end_parts = block.settings.end_date | split: '/'
                  assign end_date_iso = end_parts[2] | append: '-' | append: end_parts[1] | append: '-' | append: end_parts[0]
                  assign end_datetime = end_date_iso | append: ' ' | append: block.settings.end_time
                  assign end_timestamp = end_datetime | date: '%s' | plus: 0
                  if now_paris > end_timestamp
                    assign show_lpb_banner = false
                  endif
                endif
              endif
            -%}
            {%- if show_lpb_banner -%}
              <div class="lpb-scrolling-banner-block" style="--lpb-banner-bg: {{ block.settings.color_background }}; --lpb-banner-color: {{ block.settings.color_text }}; --lpb-banner-speed: {{ block.settings.speed }}s; --lpb-banner-padding: {{ block.settings.padding }}px;" {{ block.shopify_attributes }}>
                {{ 'lpb-scrolling-banner.css' | asset_url | stylesheet_tag }}
                <div class="lpb-scrolling-banner">
                  <div class="lpb-scrolling-banner__track">
                    <span>{{ block.settings.text }}</span>
                    <span>{{ block.settings.text }}</span>
                    <span>{{ block.settings.text }}</span>
                    <span>{{ block.settings.text }}</span>
                  </div>
                </div>
              </div>
            {%- endif -%}

          {%- when 'reassurance' -%}
            {%- assign has_reassurance_items = false -%}
            {%- for i in (1..5) -%}
              {%- assign text_key = 'item_' | append: i | append: '_text' -%}
              {%- if block.settings[text_key] != blank -%}
                {%- assign has_reassurance_items = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if has_reassurance_items -%}
              <style>
                .reassurance-{{ block.id }} {
                  padding: 16px 0;
                }
                .reassurance-{{ block.id }} .reassurance-swiper {
                  overflow: hidden;
                }
                .reassurance-{{ block.id }} .swiper-slide {
                  display: flex;
                  align-items: center;
                  gap: 8px;
                  white-space: nowrap;
                }
                .reassurance-{{ block.id }} .reassurance-icon {
                  flex-shrink: 0;
                  display: flex;
                  align-items: center;
                  font-size: 18px;
                  line-height: 1;
                }
                .reassurance-{{ block.id }} .reassurance-icon svg {
                  width: 18px;
                  height: 18px;
                }
                .reassurance-{{ block.id }} .reassurance-text {
                  font-family: var(--font-body-family, 'DM Sans', sans-serif);
                  font-size: 14px;
                  line-height: 1.4;
                  color: {{ block.settings.text_color }};
                }
                .reassurance-{{ block.id }} .reassurance-text p {
                  margin: 0;
                }
                .reassurance-{{ block.id }} .reassurance-wrapper {
                  display: flex;
                  align-items: center;
                  gap: 12px;
                }
                .reassurance-{{ block.id }} .reassurance-swiper {
                  flex: 0 1 auto;
                  min-width: 0;
                }
                .reassurance-{{ block.id }} .reassurance-dots {
                  display: flex;
                  align-items: center;
                  gap: 6px;
                  flex-shrink: 0;
                }
                .reassurance-{{ block.id }} .reassurance-dots .swiper-pagination-bullet {
                  width: 6px;
                  height: 6px;
                  border-radius: 50%;
                  background: {{ block.settings.text_color }};
                  opacity: 0.25;
                  transition: opacity 0.3s ease;
                  cursor: pointer;
                }
                .reassurance-{{ block.id }} .reassurance-dots .swiper-pagination-bullet-active {
                  opacity: 1;
                }
                @media (max-width: 767px) {
                  .reassurance-{{ block.id }} .reassurance-wrapper {
                    flex-direction: column;
                    align-items: center;
                    gap: 8px;
                  }
                  .reassurance-{{ block.id }} .swiper-slide {
                    justify-content: center;
                  }
                  .reassurance-{{ block.id }} .reassurance-dots {
                    justify-content: center;
                  }
                }
                .no-js .reassurance-{{ block.id }} .reassurance-swiper .swiper-wrapper {
                  flex-direction: column;
                  gap: 8px;
                }
                .no-js .reassurance-{{ block.id }} .reassurance-dots {
                  display: none;
                }
              </style>

              <div class="reassurance-{{ block.id }}" {{ block.shopify_attributes }}>
                <div class="reassurance-wrapper">
                  <div class="reassurance-swiper swiper">
                    <div class="swiper-wrapper">
                      {%- for i in (1..5) -%}
                        {%- assign icon_key = 'item_' | append: i | append: '_icon' -%}
                        {%- assign text_key = 'item_' | append: i | append: '_text' -%}
                        {%- if block.settings[text_key] != blank -%}
                          <div class="swiper-slide">
                            {%- if block.settings[icon_key] != blank -%}
                              <span class="reassurance-icon">{{ block.settings[icon_key] }}</span>
                            {%- endif -%}
                            <span class="reassurance-text">{{ block.settings[text_key] }}</span>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                  <div class="reassurance-dots reassurance-pagination-{{ block.id }}"></div>
                </div>
              </div>

              <script>
                (function() {
                  function initReassurance() {
                    if (typeof Swiper === 'undefined') return;
                    var container = document.querySelector('.reassurance-{{ block.id }} .reassurance-swiper');
                    if (!container) return;
                    var slideCount = container.querySelectorAll('.swiper-slide').length;
                    if (slideCount <= 1) return;
                    new Swiper(container, {
                      slidesPerView: 1,
                      loop: true,
                      speed: 500,
                      autoplay: {
                        delay: {{ block.settings.autoplay_speed }},
                        disableOnInteraction: false,
                      },
                      pagination: {
                        el: '.reassurance-pagination-{{ block.id }}',
                        clickable: true,
                      },
                    });
                  }
                  if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', function() {
                      setTimeout(initReassurance, 100);
                    });
                  } else {
                    setTimeout(initReassurance, 100);
                  }
                })();
              </script>
            {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </product-info>
    </div>

    {%- assign sticky_buy_button = section.blocks | where: 'type', 'sticky_buy_button' | first -%}
    {%- if product.available and sticky_buy_button -%}
      <product-sticky-form
        class="product-sticky-form w-full fixed z-20 bottom-0 right-0 pointer-events-none"
        id="ProductStickyForm-{{ section.id }}-{{ product.id }}"
        form="{{ product_form_id }}"
      >
        <div class="product-sticky-form__card grid gap-4 opacity-0 invisible pointer-events-auto">
          {%- assign featured_media = product.selected_or_first_available_variant.featured_media
            | default: product.featured_media
          -%}
          <div class="product-sticky-form__variant{% if featured_media == blank %} no-image{% endif %} grid items-center gap-4">
            {%- if featured_media != blank -%}
              <div
                class="hidden md:block media media--adapt relative overflow-hidden"
                data-widths="80,160"
                data-sticky-product-media
              >
                {{-
                  featured_media
                  | image_url: width: featured_media.width
                  | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160', is: 'lazy-image'
                -}}
              </div>
            {%- endif -%}

            <div class="grid gap-2">
              <div class="grid gap-1">
                <p class="text-base font-medium leading-tight">{{ product.title }}</p>
                {%- unless product.has_only_default_variant -%}
                  <div class="text-xs text-opacity leading-tight" data-sticky-product-options>
                    {{- product.selected_or_first_available_variant.title -}}
                  </div>
                {%- endunless -%}
              </div>
              <div id="StickyPrice-{{ section.id }}-{{ product.id }}">
                {%- if product.quantity_price_breaks_configured? != true -%}
                  {%- render 'product-price',
                    product: product,
                    use_variant: true,
                    class: 'flex flex-wrap items-center gap-2 lg:gap-1d5'
                  -%}
                {%- else -%}
                  {%- liquid
                    assign assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id
                    assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                    assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                    if cart_qty > 0
                      assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                    endif
                    assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price
                  -%}
                  <price-per-item
                    id="PricePerItem-{{ section.id }}-{{ product.id }}-2nd"
                    class="price flex flex-wrap items-center gap-2 lg:gap-1d5"
                    data-section-id="{{ section.id }}"
                    data-product-id="{{ product.id }}"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    {%- if variant_price_compare -%}
                      <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
                      <span class="price__sale inline-flex items-center h-auto relative">
                        {%- liquid
                          if settings.currency_code_enabled
                            echo variant_price_compare | money_with_currency
                          else
                            echo variant_price_compare | money
                          endif
                        -%}
                      </span>
                      <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
                    {%- endif -%}

                    {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                      {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        <span class="price-per-item--current price__regular whitespace-nowrap">
                          {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                        </span>
                      {%- else -%}
                        {%- for price_break in volume_pricing_array -%}
                          {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                            {%- liquid
                              if settings.currency_code_enabled
                                assign price_break_price = price_break.price | money_with_currency
                              else
                                assign price_break_price = price_break.price | money
                              endif
                            -%}
                            <span class="price-per-item--current price__regular whitespace-nowrap">
                              {{- 'products.volume_pricing.price_at_each' | t: price: price_break_price -}}
                            </span>
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                    {%- else -%}
                      <span class="price-per-item--current price__regular whitespace-nowrap">
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                      </span>
                    {%- endif -%}
                  </price-per-item>
                {%- endif -%}
              </div>
            </div>

            {%- liquid
              assign check_against_inventory = true
              if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                assign check_against_inventory = false
              endif
              if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                assign quantity_rule_soldout = true
              endif
            -%}
            <button
              type="submit"
              name="add"
              form="{{ product_form_id }}"
              class="button button--primary"
              is="hover-button"
              {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                disabled
              {% endif -%}
              {%- if product.template_suffix == 'pre-order' %}
                data-pre-order
              {% endif -%}
            >
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'icon', icon: 'cart', size: 'sm', class: 'md:hidden' -%}
                <span class="hidden md:block" data-sold-out="{{ 'products.product.sold_out' | t | escape }}">
                  {%- liquid
                    if product.selected_or_first_available_variant.available == false or quantity_rule_soldout
                      echo 'products.product.sold_out' | t
                    elsif product.template_suffix != 'pre-order'
                      echo 'products.product.add_to_cart' | t
                    else
                      echo 'products.product.pre_order' | t
                    endif
                  -%}
                </span>
              </span>
            </button>
          </div>
          <div
            class="product-form__error-message alert alert--error text-sm font-medium leading-tight"
            role="alert"
            hidden
          ></div>
        </div>
      </product-sticky-form>
    {%- endif -%}
  </div>

  {%- if first_3d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
  {%- endif -%}

  <script type="application/ld+json">
    {{- product | structured_data -}}
  </script>
</div>

<script src="{{ 'cluutch-main-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cluutch-buy-product.js' | asset_url }}" defer="defer"></script>

