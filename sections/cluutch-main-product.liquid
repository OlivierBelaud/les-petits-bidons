{{ 'cluutch-main-product.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;

  {%- render 'section-variables', section: section -%}
    @media(min-width:768px){
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- assign first_media = product.selected_or_first_available_variant.featured_media | default: product.media.first -%}
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --aspect-ratio: {{ first_media.aspect_ratio }};
    }
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      --aspect-ratio: {{ first_media.aspect_ratio }};
    }
  }
</style>

{%- liquid
  assign product_form_id = 'ProductForm-' | append: section.id | append: '-' | append: product.id
  assign media_count = product.media.size
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
-%}

{%- if first_3d_model -%}
  {{ 'model-viewer.css' | asset_url | stylesheet_tag }}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

{%- if product.quantity_price_breaks_configured? -%}
  {{ 'volume-pricing.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'volume-pricing.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div
  data-handle="{{ product.handle }}"
  class="main-product-section-handle section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}"
>
  <div class="page-width{% if media_count > 0 %}{% if section.settings.full_width %} page-width--full{% endif %}{% else %} page-width--narrow{% endif %} relative">
    <div class="featured-product main-product-section product product--{{ section.settings.gallery_layout }}{% if media_count == 0 %} no-media{% endif %} flex flex-col items-start lg:grid gap-5 w-full relative">
      {%- if media_count > 0 -%}
        <nav
          class="product__breadcrumb cluutch-main-product__breadcrumb breadcrumb flex cluutch-main-product__breadcrumb--mobile"
          role="navigation"
          aria-label="breadcrumbs"
          {{ block.shopify_attributes }}
        >
          <ul class="inline-flex  gap-4 md:gap-6">
            <li class="flex items-center gap-4 md:gap-6">
              <a
                class="block cluutch-breadcrumbs"
                href="{{ routes.root_url }}"
                title="{{ 'general.breadcrumbs.home_link_title' | t | escape }}"
              >
                {% comment %} {%- render 'icon', icon: 'home', size: 'sm' -%} {% endcomment %}
                Home
              </a>
            </li>
            /
            {% comment %}
              {%- if block.settings.show_collections_link -%}
                <li class="flex items-center gap-4 md:gap-6">
                  <a class="reversed-link" href="{{ routes.collections_url }}">{{ 'general.breadcrumbs.collections' | t }}</a>
                  /
                </li>
              {%- endif -%}
            {% endcomment %}
            <li class="flex items-center gap-4 md:gap-6">
              {%- liquid
                if collection == blank
                  assign collection = product.collections | first
                endif
              -%}
              {% if collection.title != blank %}
                <a class="reversed-link" href="{{ collection.url }}">{{ collection.title }}</a>

              {% else %}
                <a class="reversed-link" href="{{ collection.all }}">Collection</a>
              {% endif %}
            </li>
            /
            <li class="flex items-center gap-4 md:gap-6 cluutch-product-title cluutch-product-title-bread">
              {{ product.selected_or_first_available_variant.metafields.custom.cluutch_variant_title }}
            </li>
          </ul>
        </nav>
        {% assign media_list = product.selected_or_first_available_variant.metafields.custom.cluutch_media_list.value
          | join: ','
          | split: ','
        %}
        {% if media_list.size == 1 %}
          <style>
            .cluutch-product-media-gallery {
              display: flex !important;
              justify-content: center;
            }
            .swiper-button-next,
            .swiper-button-prev {
              display: none !important;
            }
          </style>
        {% endif %}
        <div class="cluutch-product-media-gallery" id="media-gallery">
          {% comment %}
            {%- render 'cluutch-product-media-gallery',
              product: product,
              product_id: product.id,
              section_id: section.id,
              gallery_layout: section.settings.gallery_layout,
              thumbnail_position: section.settings.thumbnail_position,
              image_ratio: section.settings.image_ratio,
              image_ratio_mobile: section.settings.image_ratio_mobile,
              image_zoom: section.settings.image_zoom,
              image_fill: settings.product_image_fill,
              mobile_layout: section.settings.mobile_layout,
              mobile_thumbnail: section.settings.mobile_thumbnail,
              hide_variants: section.settings.hide_variants,
              enable_video_autoplay: section.settings.enable_video_autoplay,
              enable_video_looping: section.settings.enable_video_looping,
              first_3d_model: first_3d_model,
              product_form_id: product_form_id
            -%}
          {% endcomment %}
          <div class="slider-container" style="overflow: hidden">
            <div class="swiper imgswiper">
              {%- render 'cluutch-product-badges',
                product: product,
                show_save_amount: show_save_amount,
                save_type: save_type,
                class: 'z-2 absolute grid gap-3'
              -%}
              <div class="swiper-wrapper ziz">
                {% for image in product.selected_or_first_available_variant.metafields.custom.cluutch_media_list.value %}
                  <div class="swiper-slide">
                    {{-
                      image
                      | image_url: width: master
                      | image_tag: class: 'w-full cluutch-img cluutch-product-image-main', alt: 'Product Image'
                    -}}
                  </div>
                {% endfor %}
              </div>

              <div class="swiper-pagination"></div>
              <div class="swiper-button-next">{% render 'cluutch-icon', icon: 'arrow-right-long' %}</div>
              <div class="swiper-button-prev">{% render 'cluutch-icon', icon: 'arrow-left-long' %}</div>
            </div>
          </div>

          {% if media_list.size > 1 %}
            <div class="slider-container" style="overflow: hidden">
              <div class="swiper thumb-swiper">
                <div class="swiper-wrapper">
                  {% for image in product.selected_or_first_available_variant.metafields.custom.cluutch_media_list.value %}
                    <div class="swiper-slide">
                      {{-
                        image
                        | image_url: width: master
                        | image_tag: class: 'w-full cluutch-img  cluutch-product-image-thumb', alt: 'Product Thumbnail'
                      -}}
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      {%- endif -%}

      <product-info
        id="ProductInfo-{{ section.id }}-{{ product.id }}"
        class="product__info  block{% if section.settings.enable_sticky_info %} sticky{% endif %} w-full"
        data-animate="fade-up"
        data-immediate
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-product-url="{{ product.url }}"
        data-update-url="true"
      >
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {%- render block -%}

            {%- when 'breadcrumb' -%}
              {%- render 'cluutch-product-breadcrumb', block: block -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <p
                  class="{% if block.settings.text != product.vendor %}product__text rte{% else %}product__vendor{% endif %} {{ block.settings.text_size }}"
                  {{ block.shopify_attributes }}
                >
                  {%- liquid
                    if block.settings.text != product.vendor
                      render 'icon-accordion', icon: block.settings.icon
                      echo block.settings.text
                    else
                      echo product.vendor | link_to_vendor: class: 'reversed-link'
                    endif
                  -%}
                </p>
              {%- endif -%}

            {%- when 'sku' -%}
              <p class="product__sku" id="Sku-{{ section.id }}-{{ product.id }}" {{ block.shopify_attributes }}>
                {{- product.selected_or_first_available_variant.sku -}}
              </p>

            {%- when 'description' -%}
              <div class="product__text rte {{ block.settings.text_size }}" {{ block.shopify_attributes }}>
                {{- product.description -}}
              </div>
            {% when 'variants' %}
              <div class="cluutch-main-product__paragraphe med14">
                {% if product.selected_or_first_available_variant.metafields.custom.cluutch_short_description != blank
                %}
                  {{
                    product.selected_or_first_available_variant.metafields.custom.cluutch_short_description
                    | metafield_tag
                  }}
                {% else %}
                  {{ product.metafields.my_fields.paragraphe_seo }}
                {% endif %}
              </div>

            {%- when 'title' -%}
              {%- liquid
                assign price_block = section.blocks | where: 'type', 'price' | first
                assign rating_block = section.blocks | where: 'type', 'rating' | first
              -%}
              <div
                class="product__title{% if price_block == blank and block.settings.show_price %} with-price{% endif %}"
                {{ block.shopify_attributes }}
              >
                <h1 class="heading h3 cluutch-product-title main-product-title leading-none {{ block.settings.title_size }} mobile:{{ block.settings.title_size_mobile }} col-span-full">
                  <split-words class="split-words block" data-animate="fade-up">
                    {{- product.selected_or_first_available_variant.metafields.custom.cluutch_variant_title -}}
                  </split-words>
                </h1>

                {%- if price_block == blank and block.settings.show_price -%}
                  <div id="Price-{{ section.id }}-{{ product.id }}" class="product__price">
                    {%- render 'product-price',
                      product: product,
                      use_variant: true,
                      class: 'flex flex-wrap items-baseline gap-2 lg:flex-col xl:items-end lg:gap-1d5'
                    -%}

                    {%- if product.quantity_price_breaks_configured? -%}
                      <div
                        class="text-opacity text-sm font-medium leading-tight"
                        id="VolumeNote-{{ section.id }}-{{ product.id }}"
                      >
                        {{- 'products.volume_pricing.note' | t -}}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- liquid
                  if rating_block == blank and block.settings.show_rating
                    render 'product-rating', product: product
                  endif
                -%}
              </div>

              {%- if price_block == blank and block.settings.show_price -%}
                {%- assign product_form_installment_id = 'ProductFormInstallment-'
                  | append: section.id
                  | append: '-'
                  | append: product.id
                -%}
                {%- form 'product',
                  product,
                  id: product_form_installment_id,
                  class: 'installment text-sm leading-tight'
                -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price grid gap-3" {{ block.shopify_attributes }}>
                <div class="no-js-hidden" id="Price-{{ section.id }}-{{ product.id }}">
                  {%- render 'product-price',
                    product: product,
                    use_variant: true,
                    class: 'flex flex-wrap items-baseline gap-2 lg:gap-1d5'
                  -%}

                  {%- if product.quantity_price_breaks_configured? -%}
                    <div
                      class="text-opacity text-sm font-medium leading-tight"
                      id="VolumeNote-{{ section.id }}-{{ product.id }}"
                    >
                      {{- 'products.volume_pricing.note' | t -}}
                    </div>
                  {%- endif -%}
                </div>

                {%- assign product_form_installment_id = 'ProductFormInstallment-'
                  | append: section.id
                  | append: '-'
                  | append: product.id
                -%}
                {%- form 'product',
                  product,
                  id: product_form_installment_id,
                  class: 'installment text-sm leading-tight'
                -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}

                {%- if block.settings.show_taxes_notice -%}
                  {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                    <div class="product__tax rte text-sm">
                      {%- liquid
                        if cart.taxes_included
                          echo 'products.product.include_taxes' | t
                        endif
                        if shop.shipping_policy.body != blank
                          echo 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url
                        endif
                      -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>

            {%- when 'quantity_selector' -%}
              {%- if product.available -%}
                <div id="QuantityForm-{{ section.id }}-{{ product.id }}" class="field" {{ block.shopify_attributes }}>
                  {%- assign cart_qty = cart
                    | item_count_for_variant: product.selected_or_first_available_variant.id
                  -%}
                  <label
                    for="Quantity-{{ section.id }}-{{ product.id }}"
                    class="quantity__label label"
                    is="quantity-label"
                  >
                    {{ 'products.quantity.label' | t }}
                    <span
                      id="QuantityRulesCart-{{ section.id }}-{{ product.id }}"
                      class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %} relative"
                    >
                      <span class="quantity-cart font-medium"
                        >({{ 'products.quantity.in_cart_html' | t: quantity: cart_qty }})</span
                      >
                    </span>
                  </label>
                  <div class="flex items-center gap-4">
                    <quantity-input
                      class="quantity inline-flex relative"
                      data-section-id="{{ section.id }}"
                      data-product-id="{{ product.id }}"
                    >
                      <button
                        type="button"
                        name="minus"
                        class="quantity__button"
                        aria-label="{{ 'products.quantity.decrease' | t: product: product.title | escape }}"
                      >
                        {%- render 'icon', icon: 'chevron-left', size: 'sm', class: 'stroke-2 transform' -%}
                      </button>
                      <input
                        id="Quantity-{{ section.id }}-{{ product.id }}"
                        class="quantity__input text-sm sm:text-base font-medium text-center"
                        type="number"
                        name="quantity"
                        inputmode="numeric"
                        autocomplete="off"
                        data-quantity-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        data-cart-quantity="{{ cart_qty }}"
                        data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                          data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                          max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                        value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        form="{{ product_form_id }}"
                      >
                      <button
                        type="button"
                        name="plus"
                        class="quantity__button"
                        aria-label="{{ 'products.quantity.increase' | t: product: product.title | escape }}"
                      >
                        {%- render 'icon', icon: 'chevron-right', size: 'sm', class: 'stroke-2 transform' -%}
                      </button>
                    </quantity-input>

                    {%- if product.quantity_price_breaks_configured? -%}
                      {%- liquid
                        assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                        assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                        if cart_qty > 0
                          assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                        endif
                        assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price
                      -%}
                      <price-per-item
                        id="PricePerItem-{{ section.id }}-{{ product.id }}"
                        class="price flex flex-wrap items-center gap-2 lg:gap-1d5"
                        data-section-id="{{ section.id }}"
                        data-product-id="{{ product.id }}"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      >
                        {%- if variant_price_compare -%}
                          <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
                          <span class="price__sale inline-flex items-center h-auto relative">
                            {%- liquid
                              if settings.currency_code_enabled
                                echo variant_price_compare | money_with_currency
                              else
                                echo variant_price_compare | money
                              endif
                            -%}
                          </span>
                          <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
                        {%- endif -%}

                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                          {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                            {%- liquid
                              if settings.currency_code_enabled
                                assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                              else
                                assign variant_price = product.selected_or_first_available_variant.price | money
                              endif
                            -%}
                            <span class="price-per-item--current price__regular whitespace-nowrap">
                              {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                            </span>
                          {%- else -%}
                            {%- for price_break in volume_pricing_array -%}
                              {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                                {%- liquid
                                  if settings.currency_code_enabled
                                    assign price_break_price = price_break.price | money_with_currency
                                  else
                                    assign price_break_price = price_break.price | money
                                  endif
                                -%}
                                <span class="price-per-item--current price__regular whitespace-nowrap">
                                  {{- 'products.volume_pricing.price_at_each' | t: price: price_break_price -}}
                                </span>
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- else -%}
                          <span class="price-per-item--current price__regular whitespace-nowrap">
                            {%- liquid
                              if settings.currency_code_enabled
                                assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                              else
                                assign variant_price = product.selected_or_first_available_variant.price | money
                              endif
                            -%}
                            {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                          </span>
                        {%- endif -%}
                      </price-per-item>
                    {%- endif -%}
                  </div>

                  {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1
                    or product.selected_or_first_available_variant.quantity_rule.min > 1
                    or product.selected_or_first_available_variant.quantity_rule.max != null
                  -%}
                    <div
                      class="quantity__rules text-sm font-medium leading-tight"
                      id="QuantityRules-{{ section.id }}-{{ product.id }}"
                    >
                      {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                        <span class="divider">
                          {{-
                            'products.quantity.multiples_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment
                          -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                        <span class="divider">
                          {{-
                            'products.quantity.minimum_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.min
                          -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                        <span class="divider">
                          {{-
                            'products.quantity.maximum_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.max
                          -}}
                        </span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'volume_pricing' -%}
              {%- if product.quantity_price_breaks_configured? -%}
                <volume-pricing class="volume-pricing grid gap-6" id="Volume-{{ section.id }}-{{ product.id }}">
                  {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                    <span class="caption-large font-medium">{{ 'products.volume_pricing.title' | t }}</span>
                    <ul class="list-unstyled">
                      <li class="text-sm flex gap-2d5 justify-between">
                        <span class="font-medium">
                          {{- product.selected_or_first_available_variant.quantity_rule.min }}+</span
                        >
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        <span data-text="{{ 'products.volume_pricing.price_at_each' | t: price: variant_price }}">
                          {{- 'sections.quick_order_list.each' | t: money: variant_price -}}
                        </span>
                      </li>
                      {%- for price_break in product.selected_or_first_available_variant.quantity_price_breaks -%}
                        {%- liquid
                          if settings.currency_code_enabled
                            assign price_break_price = price_break.price | money_with_currency
                          else
                            assign price_break_price = price_break.price | money
                          endif
                        -%}
                        <li class="text-sm flex gap-2d5 justify-between{% if forloop.index >= 3 %} show-more-item hidden{% endif %}">
                          <span class="font-medium">
                            {{- price_break.minimum_quantity -}}
                            <span aria-hidden="true">+</span>
                          </span>
                          <span data-text="{{ 'products.volume_pricing.price_at_each' | t: price: price_break_price }}">
                            {{- 'sections.quick_order_list.each' | t: money: price_break_price -}}
                          </span>
                        </li>
                      {%- endfor -%}
                    </ul>
                    {%- if product.selected_or_first_available_variant.quantity_price_breaks.size >= 3 -%}
                      <show-more-button>
                        <button
                          class="button-show-more link text-sm leading-tight"
                          id="ShowMore-{{ section.id }}-{{ product.id }}"
                          type="button"
                        >
                          <span class="label-show-more">{{ 'products.general.show_more' | t }}</span>
                        </button>
                      </show-more-button>
                    {%- endif -%}
                  {%- endif -%}
                </volume-pricing>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {% comment %}
                {%- render 'cluttch-product-variant-picker',
                  block: block,
                  product: product,
                  product_id: product.id,
                  section_id: section.id,
                  product_form_id: product_form_id,
                  image_ratio: section.settings.image_ratio,
                  image_ratio_mobile: section.settings.image_ratio_mobile,
                  image_fill: settings.product_image_fill
                -%}
              {% endcomment %}

            {% when 'cluutch-variant_picker' -%}
              {% if product.variants.size > 0 %}
                <div class="product-sizes-container">
                  {% assign quantity_buttons = section.blocks | where: 'type', 'quantity-button' %}
                  {% if quantity_buttons.size > 0 %}
                    <h3 class="med16">Quantité:</h3>
                  {% endif %}
                  <div class="product-sizes__container">
                    <div class="product-sizes {{ product.handle }}">
                      {% for variant in product.variants %}
                        <button
                          class="size-option"
                          data-inventory="{{ variant.inventory_quantity }}"
                          data-variant-id="{{ variant.id }}"
                          {% if variant.available == false %}
                            disabled
                          {% endif %}
                        >
                          <span>{{ variant.title | split: ' / ' | first }}</span>
                          {% if variant.metafields.custom.variant_discount != blank %}
                            <span
                              class="size-discount"
                              {% if variant.metafields.custom.variant_discount != blank %}
                                style="display: none;"
                              {% endif %}
                            >
                              {{- variant.metafields.custom.variant_discount -}}
                            </span>
                          {% endif %}
                          {% if variant.metafields.custom.cluutch_variant_image != blank %}
                            {{
                              variant.metafields.custom.cluutch_variant_image
