{%- comment -%}
  LES-56 product area (Figma HWwTV6etAdgQb7AfZ82I8l, Mobile 1:289 / Desktop 2:1090), through the accordions.
  Uses the merchant blocks and settings of cluutch-main-product. Every variant's gallery, title and
  accordions (short description included) are rendered once in <template> elements; assets/les56-product.js
  swaps them in and keeps the purchase state. The theme ProductForm (assets/theme.js) adds to the cart.
{%- endcomment -%}
{{ 'les56-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'les56-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'les56-form-' | append: section.id
  assign quantity_blocks = section.blocks | where: 'type', 'quantity-button'
  assign rating_block = section.blocks | where: 'type', 'rating' | first
  assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first

  assign multiple_variants = false
  if product.variants.size > 1
    assign multiple_variants = true
  endif

  assign has_plans = false
  for variant in product.variants
    if variant.selling_plan_allocations.size > 0
      assign has_plans = true
      break
    endif
  endfor

  # The first quantity card worth one unit is selected by default, otherwise the first card.
  assign default_quantity = quantity_blocks.first.settings.value | default: 1
  for quantity_block in quantity_blocks
    if quantity_block.settings.value == 1
      assign default_quantity = 1
      break
    endif
  endfor
  assign default_discount_bp = 0

  # Quantity discounts are only displayed for products the shop's discount applies to (tagged product).
  assign quantity_discounts = false
  assign discount_tag = section.settings.quantity_discount_tag | strip
  if discount_tag != blank and product.tags contains discount_tag
    assign quantity_discounts = true
  endif

  # The family headline and badges are claims about one product family (product type).
  assign in_family = false
  assign product_type_key = product.type | strip | downcase
  assign family_types = section.settings.family_product_types | split: ','
  for family_type in family_types
    assign family_type_key = family_type | strip | downcase
    if family_type_key != blank and family_type_key == product_type_key
      assign in_family = true
      break
    endif
  endfor

  assign accordion_keys = 'description,ingredients,usage,planet' | split: ','
  assign accordion_titles = 'Descriptif 🙌|Ingrédients naturels 🌱|Utilisation 💧|Et pour la planète ? 🌍' | split: '|'
  assign accordion_fields = 'cluutch_content_text,cluutch_content_text_second,cluutch_content_text_third,cluutch_content_text_fourth' | split: ','

  assign variant_templates = ''
  assign variants_json = ''
-%}

{%- for variant in product.variants -%}
  {%- liquid
    assign variant_title = variant.metafields.custom.cluutch_variant_title.value | default: product.title
    assign gallery_media = variant.metafields.custom.cluutch_media_list.value
    if gallery_media == blank
      assign gallery_media = product.media | reject: 'media_type', 'model'
    else
      assign product_videos = product.media | reject: 'media_type', 'image' | reject: 'media_type', 'model'
      assign gallery_media = gallery_media | concat: product_videos | uniq
    endif
    assign media_count = gallery_media.size
  -%}

  {%- capture variant_gallery -%}
    {%- if media_count > 0 -%}
      <les56-gallery class="les56-gallery">
        <div class="les56-gallery__frame">
          <div class="les56-gallery__viewport" data-les56-viewport>
            {%- for media in gallery_media -%}
              {%- liquid
                assign image = media.preview_image | default: media
                assign image_alt = media.alt | default: variant_title
                assign image_loading = 'lazy'
                assign image_priority = 'auto'
                if forloop.first and variant.id == current_variant.id
                  assign image_loading = 'eager'
                  assign image_priority = 'high'
                endif
              -%}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                <div
                  class="les56-gallery__slide les56-gallery__slide--video"
                  data-les56-slide
                  data-media-type="{{ media.media_type }}"
                  data-index="{{ forloop.index0 }}"
                  role="group"
                  aria-label="Vidéo {{ forloop.index }} sur {{ media_count }} : {{ image_alt | escape }}"
                  {% unless forloop.first %}tabindex="-1" aria-hidden="true" inert{% endunless %}
                >
                  {{ image | image_url: width: 1540 | image_tag: class: 'les56-gallery__image', alt: image_alt, loading: image_loading, fetchpriority: image_priority, widths: '380, 570, 760, 1140, 1540', sizes: '(min-width: 1024px) 770px, (min-width: 600px) 640px, 100vw', data-les56-video-poster: '' }}
                  <div class="les56-gallery__player" data-les56-player></div>
                  <template data-les56-video>
                    {%- if media.media_type == 'video' -%}
                      {{ media | video_tag: class: 'les56-gallery__video', controls: true, playsinline: true, autoplay: false, loop: section.settings.enable_video_looping, preload: 'none' }}
                    {%- else -%}
                      {{ media | external_video_url: autoplay: 0, controls: 1 | external_video_tag: class: 'les56-gallery__video', loading: 'lazy', title: image_alt }}
                    {%- endif -%}
                  </template>
                </div>
              {%- else -%}
                <button
                  type="button"
                  class="les56-gallery__slide"
                  data-les56-slide
                  data-index="{{ forloop.index0 }}"
                  aria-pressed="false"
                  aria-label="Zoomer sur l’image {{ forloop.index }} sur {{ media_count }}"
                  {% unless forloop.first %}
                    tabindex="-1" aria-hidden="true"
                  {% endunless %}
                >
                  {{
                    image
                    | image_url: width: 1540
                    | image_tag:
                      class: 'les56-gallery__image',
                      alt: image_alt,
                      loading: image_loading,
                      fetchpriority: image_priority,
                      widths: '380, 570, 760, 1140, 1540, 2048',
                      sizes: '(min-width: 1024px) 770px, (min-width: 600px) 640px, 100vw'
                  }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="les56-gallery__zoom"
            data-les56-zoom-toggle
            aria-pressed="false"
            aria-label="Zoomer sur l’image"
          ></button>
          {%- if media_count > 1 -%}
            <button
              type="button"
              class="les56-gallery__arrow les56-gallery__arrow--prev"
              data-les56-prev
              aria-label="Image précédente"
            >
              <img src="{{ 'les56-arrow.svg' | asset_url }}" alt="" width="22" height="17" loading="lazy">
            </button>
            <button
              type="button"
              class="les56-gallery__arrow les56-gallery__arrow--next"
              data-les56-next
              aria-label="Image suivante"
            >
              <img src="{{ 'les56-arrow.svg' | asset_url }}" alt="" width="22" height="17" loading="lazy">
            </button>
            <div class="les56-gallery__dots" aria-hidden="true">
              {%- for media in gallery_media -%}
                <span class="les56-gallery__dot{% if forloop.first %} is-active{% endif %}" data-les56-dot></span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        {%- if media_count > 1 -%}
          <div class="les56-gallery__thumbs">
            {%- for media in gallery_media -%}
              {%- assign image = media.preview_image | default: media -%}
              <button
                type="button"
                class="les56-gallery__thumb"
                data-les56-thumb
                data-index="{{ forloop.index0 }}"
                aria-label="Afficher {% if media.media_type == 'video' or media.media_type == 'external_video' %}la vidéo{% else %}l’image{% endif %} {{ forloop.index }}"
                {% if forloop.first %}
                  hidden
                {% endif %}
              >
                {{
                  image
                  | image_url: width: 240
                  | image_tag:
                    class: 'les56-gallery__thumb-image',
                    alt: '',
                    loading: 'lazy',
                    widths: '90, 135, 240',
                    sizes: '(min-width: 1024px) 115px, 45px'
                }}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <span class="les56-gallery__play" aria-hidden="true">{% render 'icon', icon: 'play' %}</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </les56-gallery>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture variant_description -%}
    {%- if variant.metafields.custom.cluutch_short_description != blank -%}
      {{ variant.metafields.custom.cluutch_short_description | metafield_tag }}
    {%- elsif product.metafields.my_fields.paragraphe_seo != blank -%}
      {{ product.metafields.my_fields.paragraphe_seo | metafield_tag }}
    {%- endif -%}
  {%- endcapture -%}

  {%- comment -%} The variant's short description opens the Descriptif accordion. {%- endcomment -%}
  {%- capture variant_accordions -%}
    {%- for field in accordion_fields -%}
      {%- liquid
        assign accordion_content = variant.metafields.custom[field]
        assign accordion_intro = ''
        if forloop.first
          assign accordion_intro = variant_description | strip
        endif
      -%}
      {%- if accordion_content != blank or accordion_intro != blank -%}
        <details class="les56-accordion" data-les56-accordion="{{ accordion_keys[forloop.index0] }}">
          <summary class="les56-accordion__summary">
            <span class="les56-accordion__title">{{ accordion_titles[forloop.index0] }}</span>
            <span class="les56-accordion__icon" aria-hidden="true"></span>
          </summary>
          <div class="les56-accordion__content rte">
            {%- if accordion_intro != blank -%}
              <div class="les56-accordion__intro">{{ accordion_intro }}</div>
            {%- endif -%}
            {%- if accordion_content != blank -%}
              {{ accordion_content | metafield_tag }}
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- liquid
    # Price per litre: Shopify's unit price when configured, otherwise the litre volume written in a
    # variant option value such as "1L = 33 lavages". No volume, no unit (e.g. a gift box).
    assign variant_unit_price = variant.price
    assign variant_unit_label = ''
    if variant.unit_price_measurement
      assign variant_unit_price = variant.unit_price
      if variant.unit_price_measurement.reference_value != 1
        assign variant_unit_label = variant.unit_price_measurement.reference_value
      endif
      assign variant_unit_label = variant_unit_label | append: variant.unit_price_measurement.reference_unit
    else
      for option_value in variant.options
        assign volume_text = option_value | split: '=' | first | strip | downcase
        assign volume_last = volume_text | slice: -1
        if volume_last != 'l'
          continue
        endif
        assign volume_number = volume_text | remove_last: 'l' | replace: ',', '.' | strip
        assign volume_rest = volume_number | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: '.'
        assign volume_litres = volume_number | times: 1.0
        if volume_number != blank and volume_rest == blank and volume_litres > 0
          assign variant_unit_price = variant.price | divided_by: volume_litres | round
          assign variant_unit_label = 'L'
          break
        endif
      endfor
    endif
  -%}

  {%- capture variant_json -%}
    {
      "id": {{ variant.id | json }},
      "title": {{ variant_title | json }},
      "available": {{ variant.available | json }},
      "price": {{ variant.price | json }},
      "compareAtPrice": {{ variant.compare_at_price | json }},
      "unitPrice": {% if variant_unit_label != blank %}{{ variant_unit_price | json }}{% else %}null{% endif %},
      "unitLabel": {{ variant_unit_label | json }},
      "requiresSellingPlan": {{ variant.requires_selling_plan | json }},
      "plans": [
        {%- for allocation in variant.selling_plan_allocations -%}
          {
            "id": {{ allocation.selling_plan.id | json }},
            "name": {{ allocation.selling_plan.name | json }},
            "price": {{ allocation.price | json }}
          }
          {%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      ]
    }
  {%- endcapture -%}
  {%- liquid
    unless forloop.first
      assign variants_json = variants_json | append: ','
    endunless
    assign variants_json = variants_json | append: variant_json
  -%}

  {%- if multiple_variants -%}
    {%- capture variant_template -%}
      <template data-les56-variant-template="{{ variant.id }}">
        <div data-les56-slot="gallery">{{ variant_gallery }}</div>
        <div data-les56-slot="title">{{ variant_title | escape }}</div>
        <div data-les56-slot="accordions">{{ variant_accordions }}</div>
      </template>
    {%- endcapture -%}
    {%- assign variant_templates = variant_templates | append: variant_template -%}
  {%- endif -%}

  {%- if variant.id == current_variant.id -%}
    {%- liquid
      assign live_title = variant_title
      assign live_gallery = variant_gallery
      assign live_accordions = variant_accordions
      assign unit_price = variant_unit_price
      assign unit_label = variant_unit_label
    -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  for quantity_block in quantity_blocks
    if quantity_discounts and quantity_block.settings.value == default_quantity
      assign default_discount_bp = quantity_block.settings.discount | remove: '%' | remove: '-' | replace: ',', '.' | strip | times: 100 | round
      break
    endif
  endfor

  assign compare_unit = current_variant.price
  if current_variant.compare_at_price > current_variant.price
    assign compare_unit = current_variant.compare_at_price
  endif
  assign remaining_bp = 10000 | minus: default_discount_bp
  assign default_unit = current_variant.price | times: remaining_bp | plus: 9999 | divided_by: 10000
  assign default_total = default_unit | times: default_quantity
  assign default_compare = compare_unit | times: default_quantity
-%}

{%- capture submit_content -%}
  <span class="les56-cta__label" data-les56-submit-label>
    {%- if current_variant.available -%}
      {{ 'products.product.add_to_cart' | t }}
    {%- else -%}
      {{ 'products.product.sold_out' | t }}
    {%- endif -%}
  </span>
  <span class="les56-cta__price">
    <span class="les56-cta__total" data-les56-cta-total>{{ default_total | money | replace: '.', ',' }}</span>
    <s
      class="les56-compare"
      data-les56-cta-compare
      {% unless default_compare > default_total %}
        hidden
      {% endunless %}
    >
      {{- default_compare | money | replace: '.', ',' -}}
    </s>
  </span>
{%- endcapture -%}

<les56-product
  id="Les56Product-{{ section.id }}"
  class="les56"
  data-section-id="{{ section.id }}"
  data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  style="
    --les56-strike-image: url('{{ 'les56-strike.svg' | asset_url }}');
    --les56-plus-image: url('{{ 'les56-plus.svg' | asset_url }}');
    --les56-radio-checked-image: url('{{ 'les56-radio-checked.svg' | asset_url }}');
    --les56-radio-subscription-image: url('{{ 'les56-radio-subscription.svg' | asset_url }}');
    --les56-bottle-body-image: url('{{ 'les56-bottle-body.svg' | asset_url }}');
    --les56-bottle-label-image: url('{{ 'les56-bottle-label.svg' | asset_url }}');
    --les56-bottle-cap-image: url('{{ 'les56-bottle-cap.svg' | asset_url }}');
  "
>
  <script type="application/json" data-les56-json>
    {
      "formId": {{ form_id | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "variants": [{{ variants_json }}]
    }
  </script>

  <div class="les56__inner">
    <div class="les56__layout">
      <div class="les56__media" data-les56-region="gallery">{{ live_gallery }}</div>

      <div class="les56__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="les56-app" data-les56-app>{% render block %}</div>

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <p class="les56-text {{ block.settings.text_size }}" {{ block.shopify_attributes }}>
                  {{- block.settings.text -}}
                </p>
              {%- endif -%}

            {%- when 'description' -%}
              <div class="les56-text rte" {{ block.shopify_attributes }}>{{ product.description }}</div>

            {%- when 'liquid' -%}
              {%- if block.settings.liquid != blank -%}
                <div class="les56-text rte" {{ block.shopify_attributes }}>{{ block.settings.liquid }}</div>
              {%- endif -%}

            {%- when 'title' -%}
              <div class="les56-heading" {{ block.shopify_attributes }}>
                <h1 class="les56-title" data-les56-region="title">{{ live_title | escape }}</h1>
                <p class="les56-price">
                  <span class="les56-price__value" data-les56-unit-price>
                    {{- unit_price | money | replace: '.', ',' -}}
                  </span>
                  <span
                    class="les56-price__unit"
                    data-les56-unit-label
                    {% if unit_label == blank %}
                      hidden
                    {% endif %}
                  >
                    {%- if unit_label != blank %}/{{ unit_label }}{% endif -%}
                  </span>
                </p>
                {%- liquid
                  assign rating = product.metafields.reviews.rating.value
                  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
                -%}
                {%- if rating_block and rating != blank and rating_count > 0 -%}
                  {%- assign rating_stars = rating.rating | round -%}
                  <div class="les56-rating" {{ rating_block.shopify_attributes }}>
                    <span class="les56-rating__value">{{ rating.rating | round: 1 }}/5</span>
                    <span class="les56-rating__stars" aria-hidden="true">
                      {%- for star in (1..5) -%}
                        <img
                          class="les56-rating__star{% if star > rating_stars %} is-empty{% endif %}"
                          src="{{ 'les56-star.svg' | asset_url }}"
                          alt=""
                          width="15"
                          height="15"
                        >
                      {%- endfor -%}
                    </span>
                    <span class="les56-rating__count">{{ rating_count }} avis</span>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'countdown' -%}
              {%- if product.metafields.theme.countdown.value != blank -%}
                {%- liquid
                  assign now_time = 'now' | date: '%s' | times: 1
                  assign countdown_time = product.metafields.theme.countdown.value | date: '%s' | times: 1
                -%}
                {%- if countdown_time > now_time -%}
                  <div
                    class="les56-countdown product-countdown grid sm:flex items-center justify-between gap-2d5"
                    id="shopify-block-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="flex items-center gap-3">
                      {%- render 'icon', icon: 'countdown', size: 'xl', class: 'flex-auto block lg:hidden xl:block' -%}
                      <div class="grid">
                        {%- if block.settings.heading != blank -%}
                          <p class="heading text-base lg:text-lg xl:text-xl leading-tight">
                            {{ block.settings.heading | escape }}
                          </p>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="uppercase text-3xs font-medium leading-none tracking-widest">
                            {{ block.settings.subheading | escape }}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                    <countdown-timer
                      class="countdown__timer flex text-center"
                      data-expires="{{ product.metafields.theme.countdown.value | date: '%FT%T%:z' | escape }}"
                    >
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.days' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.hours' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.minutes' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.seconds' | t }}</span>
                      </div>
                    </countdown-timer>
                    <style>
                      #shopify-block-{{ block.id }} {
                        {%- render 'section-variables', section: block -%}
                      }
                    </style>
                  </div>
                {%- endif -%}
              {%- endif -%}

            {%- when 'variants' -%}
              {%- comment -%}
                Family headline and badges only describe products of the configured family; the variant
                short description is shown in the Descriptif accordion.
              {%- endcomment -%}
              <div class="les56-family" {{ block.shopify_attributes }}>
                {%- if in_family -%}
                  {%- if section.settings.family_headline != blank -%}
                    <p class="les56-tagline">{{ section.settings.family_headline }}</p>
                  {%- endif -%}
                  {%- comment -%}
                    A leading or trailing emoji word gets its own box with the Figma glyph advance, so the
                    platform emoji font cannot widen the badges; the badge text itself is unchanged.
                    An emoji word starts with a pictograph UTF-8 sequence and only holds caseless non-ASCII.
                  {%- endcomment -%}
                  {%- liquid
                    assign badge_items = ''
                    assign badge_count = 0
                    assign badges = section.settings.badges | newline_to_br | split: '<br />'
                    for badge in badges
                      assign badge_text = badge | strip
                      if badge_text != blank
                        assign badge_words = badge_text | split: ' '
                        assign badge_html = ''
                        for badge_word in badge_words
                          assign badge_word_first = forloop.first
                          assign badge_word_icon = false
                          if forloop.first or forloop.last
                            assign badge_word_icon = true
                          endif
                          assign icon_code = badge_word | url_encode | slice: 0, 6
                          assign icon_upper = badge_word | upcase
                          assign icon_lower = badge_word | downcase
                          if badge_words.size == 1 or icon_upper != icon_lower
                            assign badge_word_icon = false
                          endif
                          unless icon_code == '%F0%9F' or icon_code == '%E2%AC' or icon_code == '%E2%AD' or icon_code contains '%E2%9'
                            assign badge_word_icon = false
                          endunless
                          if badge_word_icon
                            assign icon_chars = badge_word | split: ''
                            for icon_char in icon_chars
                              assign char_code = icon_char | url_encode | slice: 0, 2
                              unless char_code == '%C' or char_code == '%D' or char_code == '%E' or char_code == '%F'
                                assign badge_word_icon = false
                              endunless
                            endfor
                          endif

                          assign badge_piece = badge_word | escape
                          if badge_word_icon
                            assign badge_piece = '<span class="les56-badge__icon">' | append: badge_piece | append: '</span>'
                          endif
                          unless badge_word_first
                            assign badge_html = badge_html | append: ' '
                          endunless
                          assign badge_html = badge_html | append: badge_piece
                        endfor
                        assign badge_items = badge_items | append: '<li class="les56-badge">' | append: badge_html | append: '</li>'
                        assign badge_count = badge_count | plus: 1
                      endif
                    endfor
                  -%}
                  {%- if badge_count > 0 -%}
                    <ul class="les56-badges{% if badge_count > 3 %} les56-badges--rows{% endif %}" role="list">
                      {{- badge_items -}}
                    </ul>
                  {%- endif -%}
                {%- endif -%}
              </div>

            {%- when 'cluutch-variant_picker' -%}
              <div class="les56-purchase" {{ block.shopify_attributes }}>
                {%- if multiple_variants -%}
                  {%- liquid
                    assign fragrance_cards_1 = ''
                    assign fragrance_cards_2 = ''
                    assign fragrance_cards_3 = ''
                    assign fragrance_cards_4 = ''
                    assign fragrance_cards_5 = ''
                    assign fragrance_cards_other = ''
                    assign current_fragrance_name = current_variant.option1
                    assign current_fragrance_color = '#37b6ad'
                  -%}
                  {%- for variant in product.variants -%}
                    {%- liquid
                      assign fragrance_key = variant.option1 | handleize
                      assign fragrance_name = variant.option1
                      assign fragrance_image = ''
                      assign fragrance_position = 0
                      assign fragrance_color = '#37b6ad'
                      assign fragrance_text_color = '#ffffff'
                      case fragrance_key
                        when 'fleurs-blanches'
                          assign fragrance_color = '#f0813c'
                          assign fragrance_position = 1
                        when 'bebe', 'bebe-sans-parfum'
                          assign fragrance_key = 'bebe'
                          assign fragrance_name = 'Bébé Sans Parfum'
                          assign fragrance_color = '#5893f2'
                          assign fragrance_position = 2
                        when 'lavande'
                          assign fragrance_color = '#966fd7'
                          assign fragrance_position = 3
                        when 'amande-douce'
                          assign fragrance_color = '#b7c68f'
                          assign fragrance_text_color = '#fffffa'
                          assign fragrance_position = 4
                        when 'eucalyptus'
                          assign fragrance_color = '#37b6ad'
                          assign fragrance_position = 5
                      endcase

                      assign merchant_background = variant.metafields.custom.cluutch_variant_button_color.value | strip
                      assign merchant_text = variant.metafields.custom.variant_text_color.value | strip
                      if merchant_background != blank
                        assign fragrance_color = merchant_background
                      endif
                      if merchant_text != blank
                        assign fragrance_text_color = merchant_text
                      endif

                      assign fragrance_accent = fragrance_color
                      assign background_mark = fragrance_color | slice: 0
                      assign text_mark = fragrance_text_color | slice: 0
                      if background_mark == '#' and text_mark == '#'
                        assign background_brightness = fragrance_color | color_brightness
                        assign text_brightness = fragrance_text_color | color_brightness
                        if text_brightness < background_brightness
                          assign fragrance_accent = fragrance_text_color
                        endif
                      endif

                      if fragrance_position > 0
                        assign fragrance_image = 'les56-fragrance-' | append: fragrance_key | append: '.jpg'
                      endif
                      if variant.id == current_variant.id
                        assign current_fragrance_name = fragrance_name
                        assign current_fragrance_color = fragrance_accent
                      endif
                      assign fragrance_input_id = 'les56-variant-' | append: section.id | append: '-' | append: variant.id
                    -%}
                    {%- capture fragrance_card -%}
                      <input
                        type="radio"
                        class="les56-sr-only"
                        id="{{ fragrance_input_id }}"
                        name="les56-variant-{{ section.id }}"
                        value="{{ variant.id }}"
                        data-les56-variant-input
                        data-fragrance-name="{{ fragrance_name | escape }}"
                        data-fragrance-color="{{ fragrance_accent | escape }}"
                        {% if variant.id == current_variant.id %}
                          checked
                        {% endif %}
                      >
                      <label
                        for="{{ fragrance_input_id }}"
                        class="les56-fragrance les56-fragrance--{{ fragrance_key }}{% unless variant.available %} is-unavailable{% endunless %}"
                        style="--les56-fragrance-color: {{ fragrance_color | escape }}; --les56-fragrance-text: {{ fragrance_text_color | escape }}; --les56-fragrance-accent: {{ fragrance_accent | escape }};"
                      >
                        <span class="les56-fragrance__art" aria-hidden="true">
                          {%- if fragrance_image != blank -%}
                            {%- comment -%}
                              The theme asset is the unedited Figma original (2048px); Shopify serves resized copies.
                            {%- endcomment -%}
                            <img
                              class="les56-fragrance__image"
                              src="{{ fragrance_image | asset_img_url: '128x' }}"
                              srcset="
                                {{ fragrance_image | asset_img_url: '64x' }} 1x,
                                {{ fragrance_image | asset_img_url: '128x' }} 2x,
                                {{ fragrance_image | asset_img_url: '192x' }} 3x
                              "
                              alt=""
                              width="128"
                              height="128"
                              loading="lazy"
                            >
                          {%- elsif variant.featured_image -%}
                            {{
                              variant.featured_image
                              | image_url: width: 160
                              | image_tag: class: 'les56-fragrance__product-image', alt: '', loading: 'lazy'
                            }}
                          {%- endif -%}
                        </span>
                        <span class="les56-fragrance__name">{{ fragrance_name | escape }}</span>
                        {%- unless variant.available -%}
                          <span class="les56-sr-only"> ({{ 'products.product.sold_out' | t }})</span>
                        {%- endunless -%}
                      </label>
                    {%- endcapture -%}
                    {%- case fragrance_position -%}
                      {%- when 1 -%}
                        {%- assign fragrance_cards_1 = fragrance_cards_1 | append: fragrance_card -%}
                      {%- when 2 -%}
                        {%- assign fragrance_cards_2 = fragrance_cards_2 | append: fragrance_card -%}
                      {%- when 3 -%}
                        {%- assign fragrance_cards_3 = fragrance_cards_3 | append: fragrance_card -%}
                      {%- when 4 -%}
                        {%- assign fragrance_cards_4 = fragrance_cards_4 | append: fragrance_card -%}
                      {%- when 5 -%}
                        {%- assign fragrance_cards_5 = fragrance_cards_5 | append: fragrance_card -%}
                      {%- else -%}
                        {%- assign fragrance_cards_other = fragrance_cards_other | append: fragrance_card -%}
                    {%- endcase -%}
                  {%- endfor -%}
                  <fieldset class="les56-fragrances">
                    <legend class="les56-label">
                      Parfum :
                      <span
                        class="les56-label__value"
                        data-les56-fragrance-name
                        style="color: {{ current_fragrance_color | escape }};"
                      >
                        {{- current_fragrance_name | escape -}}
                      </span>
                    </legend>
                    <div class="les56-fragrances__list">
                      {{- fragrance_cards_1 -}}
                      {{- fragrance_cards_2 -}}
                      {{- fragrance_cards_3 -}}
                      {{- fragrance_cards_4 -}}
                      {{- fragrance_cards_5 -}}
                      {{- fragrance_cards_other -}}
                    </div>
                  </fieldset>
                {%- endif -%}

                {%- if quantity_blocks.size > 0 -%}
                  <fieldset class="les56-quantities">
                    <legend class="les56-label">Quantité :</legend>
                    <div class="les56-quantities__grid">
                      {%- assign quantity_checked = false -%}
                      {%- for quantity_block in quantity_blocks -%}
                        {%- liquid
                          assign quantity_value = quantity_block.settings.value | default: 1
                          assign discount_text = ''
                          if quantity_discounts
                            assign discount_text = quantity_block.settings.discount | strip
                          endif
                          assign discount_bp = discount_text | remove: '%' | remove: '-' | replace: ',', '.' | strip | times: 100 | round
                          assign quantity_remaining_bp = 10000 | minus: discount_bp
                          assign quantity_unit = current_variant.price | times: quantity_remaining_bp | plus: 9999 | divided_by: 10000
                          assign quantity_total = quantity_unit | times: quantity_value
                          assign quantity_compare = compare_unit | times: quantity_value
                          assign quantity_input_id = 'les56-quantity-' | append: section.id | append: '-' | append: forloop.index
                          assign bottle_columns = quantity_value
                          if bottle_columns > 3
                            assign bottle_columns = 3
                          endif
                          assign bottle_rows = quantity_value | plus: 2 | divided_by: 3
                        -%}
                        <input
                          type="radio"
                          class="les56-sr-only"
                          id="{{ quantity_input_id }}"
                          name="quantity"
                          form="{{ form_id }}"
                          value="{{ quantity_value }}"
                          data-les56-quantity
                          data-discount-bp="{{ discount_bp }}"
                          {% if quantity_checked == false and quantity_value == default_quantity %}
                            checked
                          {% endif %}
                        >
                        {%- if quantity_value == default_quantity -%}
                          {%- assign quantity_checked = true -%}
                        {%- endif -%}
                        <label
                          for="{{ quantity_input_id }}"
                          class="les56-quantity{% unless quantity_discounts %} les56-quantity--wrap{% endunless %}"
                          {{ quantity_block.shopify_attributes }}
                        >
                          <span class="les56-quantity__radio" aria-hidden="true"></span>
                          <span
                            class="les56-quantity__icon"
                            style="--les56-bottle-columns: {{ bottle_columns }}; --les56-bottle-rows: {{ bottle_rows }};"
                            aria-hidden="true"
                          >
                            {%- for bottle in (1..quantity_value) -%}
                              {%- assign bottle_index = forloop.index0 -%}
                              <span
                                class="les56-bottle"
                                style="--les56-bottle-column: {{ bottle_index | modulo: 3 }}; --les56-bottle-row: {{ bottle_index | divided_by: 3 }};"
                              ></span>
                            {%- endfor -%}
                          </span>
                          <span class="les56-quantity__label">{{ quantity_block.settings.text | default: quantity_value | escape }}</span>
                          <span class="les56-quantity__price">
                            <span class="les56-quantity__total" data-les56-quantity-total>
                              {{- quantity_total | money | replace: '.', ',' -}}
                            </span>
                            <s
                              class="les56-compare"
                              data-les56-quantity-compare
                              {% unless quantity_compare > quantity_total %}
                                hidden
                              {% endunless %}
                            >
                              {{- quantity_compare | money | replace: '.', ',' -}}
                            </s>
                          </span>
                          {%- liquid
                            assign quantity_popular = false
                            if quantity_discounts and quantity_value == section.settings.popular_quantity and section.settings.popular_label != blank
                              assign quantity_popular = true
                            endif
                          -%}
                          {%- if quantity_popular or discount_text != blank -%}
                            <span class="les56-quantity__pills{% if quantity_popular %} les56-quantity__pills--popular{% endif %}">
                              {%- if quantity_popular -%}
                                <span class="les56-pill les56-pill--popular">{{ section.settings.popular_label | escape }}</span>
                              {%- endif -%}
                              {%- if discount_text != blank -%}
                                <span class="les56-pill les56-pill--discount">{{ discount_text | escape }}</span>
                              {%- endif -%}
                            </span>
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endif -%}

                {%- if has_plans -%}
                  {%- liquid
                    assign subscription_percent = 0
                    assign subscription_offer = current_variant.selling_plan_allocations.first
                    if subscription_offer and current_variant.price > subscription_offer.price
                      assign subscription_percent = current_variant.price | minus: subscription_offer.price | times: 100.0 | divided_by: current_variant.price | round
                    endif

                    assign bubble_copy = section.settings.subscription_bubble_single
                    if default_quantity > 1
                      assign bubble_copy = section.settings.subscription_bubble_multiple
                    endif
                    assign bubble_amount = '-' | append: subscription_percent | append: '%'
                    if bubble_copy contains '%'
                      assign copy_before_percent = bubble_copy | split: '%' | first
                      assign copy_after_percent = bubble_copy | remove_first: copy_before_percent | remove_first: '%'
                      assign copy_before_percent = copy_before_percent | rstrip
                      assign example_discount_token = copy_before_percent | split: ' ' | last
                      if example_discount_token != blank
                        assign copy_before_percent = copy_before_percent | remove_last: example_discount_token
                      endif
                      assign bubble_text = copy_before_percent | append: bubble_amount | append: copy_after_percent
                    elsif bubble_copy != blank
                      assign bubble_text = bubble_amount | append: ' ' | append: bubble_copy
                    else
                      assign bubble_text = bubble_amount
                    endif
                  -%}
                  <div
                    class="les56-subscription"
                    data-les56-subscription
                    {% if current_variant.selling_plan_allocations.size == 0 %}
                      hidden
                    {% endif %}
                  >
                    <p class="les56-subscription__intro">{{ section.settings.subscription_intro | escape }}</p>
                    <div class="les56-subscription__option">
                      <input
                        type="checkbox"
                        class="les56-sr-only"
                        id="les56-subscribe-{{ section.id }}"
                        data-les56-subscribe
                        {% if current_variant.requires_selling_plan %}
                          checked disabled
                        {% endif %}
                      >
                      <label for="les56-subscribe-{{ section.id }}" class="les56-subscription__toggle">
                        <span class="les56-subscription__radio" aria-hidden="true"></span>
                        <span class="les56-subscription__text">
                          <span class="les56-subscription__title">Je m’abonne</span>
                          <span class="les56-subscription__note">Annulable à tout moment</span>
                        </span>
                        <span
                          class="les56-subscription__bubble"
                          data-les56-subscription-bubble
                          data-copy-single="{{ section.settings.subscription_bubble_single | escape }}"
                          data-copy-multiple="{{ section.settings.subscription_bubble_multiple | escape }}"
                          {% if subscription_percent == 0 %}
                            hidden
                          {% endif %}
                        >
                          {%- if subscription_percent > 0 -%}
                            {{- bubble_text | escape -}}
                          {%- endif -%}
                        </span>
                      </label>
                      <div class="les56-subscription__frequency" data-les56-frequency hidden>
                        <span class="les56-subscription__frequency-label" id="les56-plan-label-{{ section.id }}">
                          Livraison :
                        </span>
                        <div class="les56-plan" data-les56-plan-picker>
                          <select
                            id="les56-plan-{{ section.id }}"
                            class="les56-sr-only"
                            name="selling_plan"
                            form="{{ form_id }}"
                            data-les56-plan
                            data-variant-id="{{ current_variant.id }}"
                            tabindex="-1"
                            aria-hidden="true"
                            disabled
                          >
                            {%- for allocation in current_variant.selling_plan_allocations -%}
                              <option value="{{ allocation.selling_plan.id }}">
                                {{- allocation.selling_plan.name | escape -}}
                              </option>
                            {%- endfor -%}
                          </select>
                          <button
                            type="button"
                            class="les56-plan__trigger"
                            id="les56-plan-trigger-{{ section.id }}"
                            data-les56-plan-trigger
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            aria-controls="les56-plan-list-{{ section.id }}"
                            aria-labelledby="les56-plan-label-{{ section.id }} les56-plan-trigger-{{ section.id }}"
                          >
                            <span class="les56-plan__value" data-les56-plan-value>
                              {{- current_variant.selling_plan_allocations.first.selling_plan.name | escape -}}
                            </span>
                            <span class="les56-plan__chevron" aria-hidden="true"></span>
                          </button>
                          <ul
                            class="les56-plan__list"
                            id="les56-plan-list-{{ section.id }}"
                            role="listbox"
                            tabindex="-1"
                            aria-labelledby="les56-plan-label-{{ section.id }}"
                            data-les56-plan-list
                            hidden
                          >
                            {%- for allocation in current_variant.selling_plan_allocations -%}
                              <li
                                class="les56-plan__option"
                                id="les56-plan-list-{{ section.id }}-{{ allocation.selling_plan.id }}"
                                role="option"
                                data-value="{{ allocation.selling_plan.id }}"
                                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                              >
                                {{- allocation.selling_plan.name | escape -}}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'buy_buttons' -%}
              <div class="les56-buy" {{ block.shopify_attributes }}>
                {%- form 'product',
                  product,
                  id: form_id,
                  class: 'les56-form',
                  is: 'product-form',
                  data-les56-form: ''
                -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-les56-variant-id>
                  {%- if quantity_blocks.size == 0 -%}
                    <input type="hidden" name="quantity" value="1">
                  {%- endif -%}
                  <button
                    type="submit"
                    name="add"
                    class="les56-cta"
                    data-les56-submit="main"
                    {% unless current_variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{- submit_content -}}
                  </button>
                  <div class="product-form__error-message les56-error" role="alert" hidden></div>
                {%- endform -%}
              </div>

            {%- when 'reassurance' -%}
              {%- assign reassurance_count = 0 -%}
              {%- for i in (1..5) -%}
                {%- assign reassurance_text_key = 'item_' | append: i | append: '_text' -%}
                {%- if block.settings[reassurance_text_key] != blank -%}
                  {%- assign reassurance_count = reassurance_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if reassurance_count > 0 -%}
                <les56-rotator
                  class="les56-reassurance"
                  data-interval="{{ block.settings.autoplay_speed }}"
                  style="--les56-reassurance-color: {{ block.settings.text_color }};"
                  {{ block.shopify_attributes }}
                >
                  <div class="les56-reassurance__items">
                    {%- assign reassurance_index = 0 -%}
                    {%- for i in (1..5) -%}
                      {%- liquid
                        assign reassurance_icon_key = 'item_' | append: i | append: '_icon'
                        assign reassurance_text_key = 'item_' | append: i | append: '_text'
                      -%}
                      {%- if block.settings[reassurance_text_key] != blank -%}
                        <div
                          class="les56-reassurance__item"
                          data-les56-rotator-item
                          {% if reassurance_index > 0 %}
                            hidden
                          {% endif %}
                        >
                          {%- if block.settings[reassurance_icon_key] != blank -%}
                            <span class="les56-reassurance__icon" aria-hidden="true">
                              {{- block.settings[reassurance_icon_key] -}}
                            </span>
                          {%- endif -%}
                          <div class="les56-reassurance__text">{{ block.settings[reassurance_text_key] }}</div>
                        </div>
                        {%- assign reassurance_index = reassurance_index | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- if reassurance_count > 1 -%}
                    <div class="les56-reassurance__dots">
                      {%- for i in (1..reassurance_count) -%}
                        <button
                          type="button"
                          class="les56-reassurance__dot"
                          data-les56-rotator-dot
                          aria-label="Afficher le message {{ i }} sur {{ reassurance_count }}"
                          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                        ></button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </les56-rotator>
              {%- endif -%}

            {%- when 'product_variations' -%}
              {%- render 'product-variants', block: block, product: product, product_id: product.id, section_id: section.id -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="les56__details">
      {%- assign accordions_rendered = false -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'collapsible_tab' -%}
            {%- unless accordions_rendered -%}
              <div class="les56-accordions" data-les56-region="accordions" {{ block.shopify_attributes }}>
                {{- live_accordions -}}
              </div>
              {%- assign accordions_rendered = true -%}
            {%- endunless -%}

          {%- when 'icons' -%}
            <ul class="les56-icons" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- liquid
                  assign icon_setting = 'icon_' | append: i
                  assign text_setting = 'text_' | append: i
                -%}
                {%- unless block.settings[icon_setting] == blank and block.settings[text_setting] == blank -%}
                  <li class="les56-icons__item">
                    <span class="les56-icons__icon" aria-hidden="true">{{ block.settings[icon_setting] }}</span>
                    <span class="les56-icons__text">{{ block.settings[text_setting] | escape }}</span>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
        {%- endcase -%}
      {%- endfor -%}
      <div class="les56-relocated-apps" data-les56-app-slot></div>
    </div>
  </div>

  {%- if buy_block -%}
    <div class="les56-sticky" data-les56-sticky hidden>
      <div class="les56-sticky__inner">
        <p class="les56-sticky__title" data-les56-sticky-title>{{ live_title | escape }}</p>
        <button
          type="submit"
          name="add"
          form="{{ form_id }}"
          class="les56-cta les56-cta--sticky"
          data-les56-submit="sticky"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          {{- submit_content -}}
        </button>
      </div>
      <p class="les56-error les56-sticky__error" data-les56-sticky-error role="alert" hidden></p>
    </div>
  {%- endif -%}

  {{- variant_templates -}}

  <script type="application/ld+json">
    {{- product | structured_data -}}
  </script>
</les56-product>

{% schema %}
{
  "name": "LES-56 main product",
  "class": "les56-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "t:sections.main-product.settings.enable_sticky_info.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-product.settings.header__media.content",
      "info": "t:sections.main-product.settings.header__media.info"
    },
    {
      "type": "header",
      "content": "Recommended image size",
      "info": "Recommended image size: 1200px 1200px"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "visible_if": "{{ false }}",
      "options": [
        {
          "value": "scroll",
          "label": "t:sections.main-product.settings.gallery_layout.options__1.label"
        },
        {
          "value": "columns",
          "label": "t:sections.main-product.settings.gallery_layout.options__2.label"
        },
        {
          "value": "thumbnail",
          "label": "t:sections.main-product.settings.gallery_layout.options__3.label"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "thumbnail",
      "label": "t:sections.main-product.settings.gallery_layout.label"
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "options": [
        {
          "value": "beside",
          "label": "t:sections.main-product.settings.thumbnail_position.options__1.label"
        },
        {
          "value": "below",
          "label": "t:sections.main-product.settings.thumbnail_position.options__2.label"
        },
        {
          "value": "after",
          "label": "After media"
        }
      ],
      "default": "beside",
      "label": "t:sections.main-product.settings.thumbnail_position.label",
      "info": "t:sections.main-product.settings.thumbnail_position.info"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.global.settings.image_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.global.settings.image_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.global.settings.image_ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.global.settings.image_ratio.options__4.label"
        },
        {
          "value": "wide",
          "label": "t:sections.global.settings.image_ratio.options__5.label"
        },
        {
          "value": "adapt_first",
          "label": "t:sections.global.settings.image_ratio.options__7.label"
        }
      ],
      "default": "adapt_first",
      "label": "t:sections.global.settings.image_ratio.label",
      "info": "t:sections.main-product.settings.image_ratio.info"
    },
    {
      "type": "select",
      "id": "image_zoom",
      "visible_if": "{{ false }}",
      "options": [
        {
          "value": "lightbox",
          "label": "t:sections.main-product.settings.image_zoom.options__1.label"
        },
        {
          "value": "hover",
          "label": "t:sections.main-product.settings.image_zoom.options__2.label"
        },
        {
          "value": "none",
          "label": "t:sections.main-product.settings.image_zoom.options__3.label"
        }
      ],
      "default": "lightbox",
      "label": "t:sections.main-product.settings.image_zoom.label",
      "info": "t:sections.main-product.settings.image_zoom.info"
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "t:sections.main-product.settings.hide_variants.label"
    },
    {
      "type": "checkbox",
      "id": "enable_video_autoplay",
      "default": false,
      "label": "t:sections.main-product.settings.enable_video_autoplay.label",
      "info": "t:sections.main-product.settings.enable_video_autoplay.info"
    },
    {
      "type": "checkbox",
