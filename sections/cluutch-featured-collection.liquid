{{ 'cluutch-featured-collections.css' | asset_url | stylesheet_tag }}
{{ 'cluutch-featured-collection.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
     --section-padding-top: {{ section.settings.padding_top_mobile }}px;
     --section-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;

   {%- render 'section-variables', section: section -%}
     @media(min-width:768px){
       --section-padding-top: {{ section.settings.padding_top }}px;
       --section-padding-bottom: {{ section.settings.padding_bottom }}px;
     }
   }
</style>

{%- liquid
  assign collection = section.settings.collection
  assign products = section.settings.products | default: collection.products
-%}
<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- capture view_all -%}
      {%- if section.settings.show_view_all and collection != blank and section.settings.product_limit < collection.all_products_count -%}
        <a class="button button--secondary icon-with-text" href="{{ collection.url }}" is="hover-link" aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}">
          <span class="btn-fill" data-fill></span>
          <span class="btn-text">
            {%- liquid
              render 'icon', icon: 'newspaper'
              echo 'sections.featured_collection.view_all' | t
            -%}
          </span>
        </a>
      {%- endif -%}
    {%- endcapture -%}

    {%- render 'cluutch-section-heading', section: section, section_button: indicators -%}
    {% comment %}
      {%- if section.settings.carousel_on_desktop -%}
        {%- for block in section.blocks -%}
          <div
            class="indicators hidden cluutch-collections__buttons lg:flex gap-2d5"
            {% unless forloop.first %}
              hidden
            {% endunless %}
            data-index="{{ forloop.index0 }}"
          >
            <button
              class="button button--secondary"
              type="button"
              is="previous-button"
              aria-controls="Slider-{{ block.id }}"
              aria-label="{{ 'general.pagination.previous' | t | escape }}"
              disabled
            >
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'cluutch-icon', icon: 'arrow-left-long', class: 'transform' -%}
              </span>
            </button>
            <button
              class="button button--secondary"
              type="button"
              is="next-button"
              aria-controls="Slider-{{ block.id }}"
              aria-label="{{ 'general.pagination.next' | t | escape }}"
            >
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'cluutch-icon', icon: 'arrow-right-long', class: 'transform' -%}
              </span>
            </button>
          </div>
        {%- endfor -%}
      {%- endif -%}
    {% endcomment %}
    <div class="cluutch-slider">
      {% comment %} {%- capture indicators -%} {% endcomment %}
      {%- if section.settings.carousel_on_desktop -%}
        <div class="indicators hidden cluutch-collections__buttons lg:flex gap-2d5">
          <button
            class="button button--secondary"
            type="button"
            is="previous-button"
            aria-controls="Slider-{{ section.id }}"
            aria-label="{{ 'general.pagination.previous' | t | escape }}"
            disabled
          >
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'cluutch-icon', icon: 'arrow-left-long', class: 'transform' -%}
            </span>
          </button>
          <button
            class="button button--secondary"
            type="button"
            is="next-button"
            aria-controls="Slider-{{ section.id }}"
            aria-label="{{ 'general.pagination.next' | t | escape }}"
          >
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'cluutch-icon', icon: 'arrow-right-long', class: 'transform' -%}
            </span>
          </button>
        </div>
        <p class="lg:hidden">{{ view_all }}</p>
      {%- else -%}
        <p>{{ view_all }}</p>
      {%- endif -%}
      {% comment %} {%- endcapture -%} {% endcomment %}
      <slider-element
        id="Slider-{{ section.id }}"
        class="grid slider{% if section.settings.carousel_on_desktop %} slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}"
        selector=".card-grid>.card"
      >
        <motion-list class="product-grid cluutch-grid card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
          {%- for product in products limit: section.settings.product_limit -%}
            {% if product.tags contains 'new' %}
              {%- if product.variants.size == 1 -%}
                {%- render 'cluutch-product-card',
                  product: product,
                  product_id: product.id,
                  section_id: section.id,
                  lazy_load: false,
                  image_ratio: settings.product_image_ratio,
                  image_fill: settings.product_image_fill,
                  show_secondary_image: settings.product_secondary_image,
                  show_vendor: settings.product_vendor,
                  show_rating: settings.product_rating,
                  show_color_swatches: settings.product_color_swatches,
                  show_countdown: settings.product_countdown,
                  show_quick_add: settings.product_quick_add,
                  show_quick_view: settings.product_quick_view,
                  show_save_amount: settings.product_save_amount,
                  save_type: settings.product_save_type
                -%}
              {% else %}
                {%- liquid
                  assign rating_max = 5
                  if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0
                    assign rating_value = product.metafields.reviews.rating.value.rating | round: 1
                    assign rating_count = product.metafields.reviews.rating_count.value
                    assign rating_max = product.metafields.reviews.rating.value.scale_max
                  elsif show_empty
                    assign rating_value = 0.0
                    assign rating_count = 0
                  elsif show_placeholder
                    assign rating_value = 4.5
                    assign rating_count = 2
                  else
                    assign hide_rating = true
                  endif
                -%}

                {% if collection.handle == 'bebe-les-petits-bidons' %}
                  {%- for variant in product.variants -%}
                    {% if variant.title contains 'Bébé'
                      or variant.metafields.custom.collection_category contains 'Bébé'
                    %}
                      <div class="card cluutch-card product-card product-card--card flex flex-col leading-none relative overflow-hidden">
                        <div class="product-card__media cluutch-card__media relative h-auto overflow-hidden">
                          <a
                            href="{{ variant.url }}"
                            class="block relative media media--adapt media--contain overflow-hidden"
                          >
                            {% if variant.image %}
                              {{
                                variant.image
                                | image_url: width: master
                                | image_tag: loading: 'lazy', alt: variant.title, class: 'variant-image__img'
                              }}
                            {% else %}
                              {{
                                product.featured_image
                                | image_url: width: master
                                | image_tag: loading: 'lazy', alt: product.title, class: 'variant-image__img'
                              }}
                            {% endif %}
                          </a>

                          <div class="cluutch-badges-wrapper">
                            {% if variant.metafields.custom.label_texte != blank and variant.metafields.custom.label_color != blank %}
                              <p class="cluutch-badge" style="background: {{ variant.metafields.custom.label_color }}; color: #ffffff;">
                                {{ variant.metafields.custom.label_texte | escape }}
                              </p>
                            {% endif %}
                            {% if variant.metafields.custom.label_text_2 != blank and variant.metafields.custom.label_color_2 != blank %}
                              <p class="cluutch-badge" style="background: {{ variant.metafields.custom.label_color_2 }}; color: #ffffff;">
                                {{ variant.metafields.custom.label_text_2 | escape }}
                              </p>
                            {% endif %}
                            {% if variant.metafields.custom.cluutch_meilleure != blank %}
                              <p class="cluutch-badge cluutch-badge--yellow">
                                {{ variant.metafields.custom.cluutch_meilleure }}
                              </p>
                            {% endif %}
                            {% if variant.metafields.custom.cluutch_sans != blank %}
                              <p class="cluutch-badge cluutch-badge--blue">
                                {{ variant.metafields.custom.cluutch_sans }}
                              </p>
                            {% endif %}
                            {% if variant.metafields.custom.cluutch_lavande != blank %}
                              <p class="cluutch-badge cluutch-badge--blue-lava">
                                {{ variant.metafields.custom.cluutch_lavande }}
                              </p>
                            {% endif %}
                            {% if variant.metafields.custom.cluutch_fleurs != blank %}
                              <p class="cluutch-badge cluutch-badge--orange">
                                {{ variant.metafields.custom.cluutch_fleurs }}
                              </p>
                            {% endif %}
                            {% if variant.metafields.custom.cluutch_eucalyptus != blank %}
                              <p class="cluutch-badge cluutch-badge--mint">
                                {{ variant.metafields.custom.cluutch_eucalyptus }}
                              </p>
                            {% endif %}
                          </div>
                        </div>

                        <div class="product-card__content cluutch-card__content grow flex flex-col justify-start text-left">
                          <div
                            class="product-card__details cluutch-card__details flex flex-col  items-baseline gap-2 w-full"
                          >
                            <div class="product-card__flex">
                              <p class="grow cluutch-grow">
                                <a
                                  class="product-card__title reversed-link text-base-xl font-medium leading-tight"
                                  href="{{ variant.url }}"
                                >
                                  {{- variant.metafields.custom.cluutch_variant_title -}}
                                </a>
                              </p>

                              {%- unless hide_rating -%}
                                <div
                                  class="rating cluutch-rating product-card__rating rounded-full flex items-center gap-2 md:gap-1d5 pointer-events-none"
                                  title="{{ 'general.accessibility.star_reviews_count' | t: count: rating_count | escape }}"
                                >
                                  <span
                                    role="img"
                                    aria-label="{{ 'general.accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max }}"
                                  >
                                    {%- render 'cluutch-icon', icon: 'star' -%}
                                  </span>
                                  <p>{{ rating_value }}</p>
                                  <p>({{ rating_count }})</p>
                                </div>
                              {%- endunless -%}
                            </div>

                            <div class="price flex flex-wrap  gap-2 md:gap-1d5 cluutch-price">
                              {% if variant.compare_at_price > variant.price %}
                                <span class="price--sale">{{ variant.price | money }}</span>
                                <span class="price--compare"
                                  ><del>{{ variant.compare_at_price | money }}</del></span
                                >
                              {% else %}
                                <span class="price__regular whitespace-nowrap">{{ variant.price | money }}</span>
                              {% endif %}
                            </div>
                            <div class="quick-add flex justify-end md:justify-center w-full z-1 pointer-events-none">
                              {%- form 'product', product, is: 'product-form', id: product_form_id -%}
                                <input type="hidden" name="id" value="{{ variant.id }}">
                                {%- liquid
                                  if product.template_suffix != 'pre-order'
                                    assign quick_add_label = 'products.product.add_to_cart' | t
                                  else
                                    assign quick_add_label = 'products.product.pre_order' | t
                                  endif
                                -%}
                                <button
                                  type="submit"
                                  class="button button--primary pointer-events-auto "
                                  is="hover-button"
                                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                                  aria-label="{{ quick_add_label | escape }}"
                                  {% unless product.variants.first.available %}
                                    disabled="disabled"
                                  {% endunless %}
                                >
                                  <span class="btn-fill" data-fill></span>
                                  <span class="btn-text">
                                    {% comment %} {%- render 'icon', icon: 'cart', size: 'sm', class: 'md:hidden' -%} {% endcomment %}
                                    {% if template.name == 'collection' %}
                                      <span
                                        class=" hidden md:block"
                                        data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
                                      >
                                        {% if product.variants.first.available %}
                                          {{- quick_add_label -}}
                                        {% else %}
                                          Épuisé
                                        {% endif %}
                                      </span>
                                      <span
                                        class="block  md:hidden"
                                        data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
                                      >
                                        {% if product.variants.first.available %}
                                          {{- quick_add_label -}}
                                        {% else %}
                                          Épuisé
                                        {% endif %}
                                      </span>
                                    {% else %}
                                      <span
                                        class="block"
                                        data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
                                      >
                                        {% if product.variants.first.available %}
                                          {{- quick_add_label -}}
                                        {% else %}
                                          Épuisé
                                        {% endif %}
                                      </span>
                                    {% endif %}
                                  </span>
                                </button>
                              {%- endform -%}
                            </div>
                          </div>
                        </div>
                      </div>
                    {% endif %}
                  {%- endfor -%}
