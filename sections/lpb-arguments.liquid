{% assign section_id = section.id | replace: '_', '' | replace: '-', '' | downcase %}

{% style %}
  .lpb-arguments-{{ section_id }} {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .lpb-arguments-{{ section_id }} {
      padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    }
  }

  .lpb-arguments__container-{{ section_id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 16px;
  }

  @media screen and (min-width: 750px) {
    .lpb-arguments__container-{{ section_id }} {
      padding: 0;
    }
  }

  .lpb-arguments__title-{{ section_id }} {
    font-family: 'Raleway', sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
    color: {{ section.settings.title_color }};
    margin: 0 0 24px 0;
    text-align: left;
  }

  .lpb-arguments__title-{{ section_id }} p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .lpb-arguments__title-{{ section_id }} {
      font-size: 32px;
      margin-bottom: 32px;
      text-align: center;
    }
  }

  @media screen and (min-width: 1024px) {
    .lpb-arguments__title-{{ section_id }} {
      font-size: {{ section.settings.title_font_size }}px;
    }
  }

  .lpb-arguments__list-{{ section_id }} {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.items_gap_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .lpb-arguments__list-{{ section_id }} {
      gap: {{ section.settings.items_gap }}px;
      align-items: center;
    }
  }

  .lpb-arguments__item-{{ section_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  @media screen and (min-width: 750px) {
    .lpb-arguments__item-{{ section_id }} {
      justify-content: center;
    }
  }

  .lpb-arguments__icon-{{ section_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: {{ section.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lpb-arguments__icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
  }

  .lpb-arguments__text-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: {{ section.settings.text_font_size_mobile }}px;
    font-weight: {{ section.settings.text_font_weight }};
    line-height: 1.4;
    color: {{ section.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .lpb-arguments__text-{{ section_id }} {
      font-size: {{ section.settings.text_font_size }}px;
    }
  }
{% endstyle %}

<section class="lpb-arguments-{{ section_id }}">
  <div class="lpb-arguments__container-{{ section_id }}">
    {% if section.settings.title != blank %}
      <div class="lpb-arguments__title-{{ section_id }}">
        {{ section.settings.title }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="lpb-arguments__list-{{ section_id }}">
        {% for block in section.blocks %}
          {% if block.settings.text != blank %}
            <li class="lpb-arguments__item-{{ section_id }}" {{ block.shopify_attributes }}>
              <span class="lpb-arguments__icon-{{ section_id }}">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="20" height="20" rx="4" fill="currentColor" fill-opacity="0.15"/>
                  <path d="M14.5 7L8.5 13L5.5 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="lpb-arguments__text-{{ section_id }}">{{ block.settings.text }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "LPB Arguments",
  "tag": "section",
  "class": "lpb-arguments-section",
  "settings": [
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Titre",
      "default": "<p>La lessive naturelle qui lave vraiment... tout en respectant votre peau et la planète</p>"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Taille du titre (desktop)",
      "min": 24,
      "max": 48,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Arguments"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Taille du texte (desktop)",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Taille du texte (mobile)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "Graisse du texte",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "items_gap",
      "label": "Espacement entre items (desktop)",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "items_gap_mobile",
      "label": "Espacement entre items (mobile)",
      "min": 8,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 600,
      "max": 1400,
      "step": 50,
      "default": 1000,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal (desktop)",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding haut (desktop)",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bas (desktop)",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding haut (mobile)",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bas (mobile)",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#F5F5F0"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#003435"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#003435"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Couleur de l'icône",
      "default": "#007E7F"
    }
  ],
  "blocks": [
    {
      "type": "argument",
      "name": "Argument",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte de l'argument",
          "default": "La performance d'une lessive classique."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LPB Arguments",
      "blocks": [
        {
          "type": "argument",
          "settings": {
            "text": "La performance d'une lessive classique."
          }
        },
        {
          "type": "argument",
          "settings": {
            "text": "La douceur d'une formule naturelle certifiée Ecocert."
          }
        },
        {
          "type": "argument",
          "settings": {
            "text": "Sans ingrédients nocifs pour vous ou pour la planète."
          }
        }
      ]
    }
  ]
}
{% endschema %}
