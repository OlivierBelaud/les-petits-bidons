    },
    {
      "type": "text",
      "id": "column1_title",
      "label": "Titre",
      "default": "Les Petits Bidons"
    },
    {
      "type": "text",
      "id": "column1_arg_1",
      "label": "Argument 1",
      "default": "Ingrédients d'origine naturelle"
    },
    {
      "type": "text",
      "id": "column1_arg_2",
      "label": "Argument 2",
      "default": "Testée sur peaux sensibles"
    },
    {
      "type": "text",
      "id": "column1_arg_3",
      "label": "Argument 3",
      "default": "Certifiée par le label ECOCERT"
    },
    {
      "type": "text",
      "id": "column1_arg_4",
      "label": "Argument 4",
      "default": "Fabriquée en France de A à Z"
    },
    {
      "type": "text",
      "id": "column1_arg_5",
      "label": "Argument 5",
      "default": "Emballage recyclé"
    },
    {
      "type": "text",
      "id": "column1_arg_6",
      "label": "Argument 6"
    },
    {
      "type": "text",
      "id": "column1_arg_7",
      "label": "Argument 7"
    },
    {
      "type": "text",
      "id": "column1_arg_8",
      "label": "Argument 8"
    },
    {
      "type": "header",
      "content": "Colonne 2 - Les autres"
    },
    {
      "type": "image_picker",
      "id": "column2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "column2_title",
      "label": "Titre",
      "default": "Les autres"
    },
    {
      "type": "text",
      "id": "column2_arg_1",
      "label": "Argument 1",
      "default": "Huile de palme et dérivés de pétrole"
    },
    {
      "type": "text",
      "id": "column2_arg_2",
      "label": "Argument 2",
      "default": "Conservateurs allergisants"
    },
    {
      "type": "text",
      "id": "column2_arg_3",
      "label": "Argument 3",
      "default": "Pas de certification ou moins stricte"
    },
    {
      "type": "text",
      "id": "column2_arg_4",
      "label": "Argument 4",
      "default": "Fabriqué en majorité à l'étranger"
    },
    {
      "type": "text",
      "id": "column2_arg_5",
      "label": "Argument 5",
      "default": "Trop de plastique"
    },
    {
      "type": "text",
      "id": "column2_arg_6",
      "label": "Argument 6"
    },
    {
      "type": "text",
      "id": "column2_arg_7",
      "label": "Argument 7"
    },
    {
      "type": "text",
      "id": "column2_arg_8",
      "label": "Argument 8"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texte du bouton",
      "default": "Voir les lessives naturelles"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#FDF6E3"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fond des cartes",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Bordure des cartes",
      "default": "#E8E8E8"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#003435"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#003435"
    },
    {
      "type": "select",
      "id": "arguments_font_weight",
      "label": "Graisse des arguments",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Couleur check",
      "default": "#007E7F"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Couleur croix",
      "default": "#D64545"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fond du bouton",
      "default": "#007E7F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texte du bouton",
      "default": "#FFFFFF"
    },
