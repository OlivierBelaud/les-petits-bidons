{% assign section_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .lpb-comparison-{{ section_id }} {
    padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.background_color }};
    border-radius: 24px;
    margin: 0 {{ section.settings.section_margin_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison-{{ section_id }} {
      padding: {{ section.settings.padding_top }}px 60px {{ section.settings.padding_bottom }}px;
      margin: 0;
      border-radius: 24px;
    }
  }

  .lpb-comparison__container-{{ section_id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Mobile: titre en haut */
  .lpb-comparison__title-{{ section_id }} {
    font-family: 'Raleway', sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    color: {{ section.settings.title_color }};
    margin: 0 0 24px 0;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__title-{{ section_id }} {
      font-size: 32px;
      margin-bottom: 32px;
    }
  }

  @media screen and (min-width: 1024px) {
    .lpb-comparison__title-{{ section_id }} {
      font-size: 40px;
    }
  }

  /* Desktop: layout horizontal */
  @media screen and (min-width: 1024px) {
    .lpb-comparison__layout-{{ section_id }} {
      display: flex;
      align-items: center;
      gap: 48px;
    }

    .lpb-comparison__title-{{ section_id }} {
      flex: 0 0 280px;
      text-align: left;
      margin-bottom: 0;
    }

    .lpb-comparison__content-{{ section_id }} {
      flex: 1;
    }
  }

  /* Grille des 4 blocs */
  .lpb-comparison__grid-{{ section_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.grid_row_gap_mobile }}px {{ section.settings.grid_column_gap_mobile }}px;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__grid-{{ section_id }} {
      gap: {{ section.settings.grid_row_gap }}px {{ section.settings.grid_column_gap }}px;
    }
  }

  /* VS badge au centre des blocs du haut */
  .lpb-comparison__vs-{{ section_id }} {
    position: absolute;
    left: 50%;
    top: 70px;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    background-color: #fff;
    border-radius: 50%;
    border: 2px solid {{ section.settings.title_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__vs-{{ section_id }} {
      width: 48px;
      height: 48px;
      font-size: 14px;
      top: 95px;
    }
  }

  /* Positionner le VS au milieu de la première ligne */
  .lpb-comparison__header-row-{{ section_id }} {
    display: contents;
  }

  /* Bloc blanc - image + titre */
  .lpb-comparison__image-block-{{ section_id }} {
    background-color: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: 20px;
    border: 1px solid {{ section.settings.card_border_color }};
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__image-block-{{ section_id }} {
      padding: 24px;
    }
  }

  .lpb-comparison__image-{{ section_id }} {
    width: 80px;
    height: 80px;
    object-fit: contain;
    margin-bottom: 12px;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__image-{{ section_id }} {
      width: 120px;
      height: 120px;
    }
  }

  .lpb-comparison__column-title-{{ section_id }} {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__column-title-{{ section_id }} {
      font-size: 18px;
    }
  }

  /* Bloc blanc - arguments */
  .lpb-comparison__args-block-{{ section_id }} {
    background-color: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: 16px;
    border: 1px solid {{ section.settings.card_border_color }};
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__args-block-{{ section_id }} {
      padding: 20px;
    }
  }

  .lpb-comparison__list-{{ section_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__list-{{ section_id }} {
      gap: 16px;
    }
  }

  .lpb-comparison__item-{{ section_id }} {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: {{ section.settings.arguments_font_weight }};
    line-height: 1.4;
    color: {{ section.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__item-{{ section_id }} {
      font-size: 14px;
      gap: 12px;
    }
  }

  .lpb-comparison__icon-{{ section_id }} {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__icon-{{ section_id }} {
      width: 20px;
      height: 20px;
    }
  }

  .lpb-comparison__icon--check-{{ section_id }} {
    color: {{ section.settings.check_color }};
  }

  .lpb-comparison__icon--cross-{{ section_id }} {
    color: {{ section.settings.cross_color }};
  }

  .lpb-comparison__button-wrapper-{{ section_id }} {
    margin-top: 24px;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__button-wrapper-{{ section_id }} {
      margin-top: 32px;
      display: flex;
      justify-content: center;
    }
  }

  .lpb-comparison__button-{{ section_id }} {
    display: block;
    width: 100%;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.2s ease;
  }

  @media screen and (min-width: 750px) {
    .lpb-comparison__button-{{ section_id }} {
      display: inline-block;
      width: auto;
      font-size: 16px;
      padding: 16px 48px;
    }
  }

  .lpb-comparison__button-{{ section_id }}:hover {
    opacity: 0.9;
  }
{% endstyle %}

<div class="lpb-comparison-{{ section_id }}">
  <div class="lpb-comparison__container-{{ section_id }}">
    <div class="lpb-comparison__layout-{{ section_id }}">
      {% if section.settings.title != blank %}
        <h2 class="lpb-comparison__title-{{ section_id }}">{{ section.settings.title }}</h2>
      {% endif %}

      <div class="lpb-comparison__content-{{ section_id }}">
        <!-- Grille 2x2 des 4 blocs -->
        <div class="lpb-comparison__grid-{{ section_id }}">
          <!-- VS badge -->
          <div class="lpb-comparison__vs-{{ section_id }}">VS</div>

          <!-- Bloc haut gauche - Image Les Petits Bidons -->
          <div class="lpb-comparison__image-block-{{ section_id }}">
            {% if section.settings.column1_image != blank %}
              <img
                src="{{ section.settings.column1_image | image_url: width: 240 }}"
                alt="{{ section.settings.column1_title }}"
                class="lpb-comparison__image-{{ section_id }}"
                loading="lazy"
              >
            {% endif %}
            {% if section.settings.column1_title != blank %}
              <h3 class="lpb-comparison__column-title-{{ section_id }}">{{ section.settings.column1_title }}</h3>
            {% endif %}
          </div>

          <!-- Bloc haut droit - Image Les autres -->
          <div class="lpb-comparison__image-block-{{ section_id }}">
            {% if section.settings.column2_image != blank %}
              <img
                src="{{ section.settings.column2_image | image_url: width: 240 }}"
                alt="{{ section.settings.column2_title }}"
                class="lpb-comparison__image-{{ section_id }}"
                loading="lazy"
              >
            {% endif %}
            {% if section.settings.column2_title != blank %}
              <h3 class="lpb-comparison__column-title-{{ section_id }}">{{ section.settings.column2_title }}</h3>
            {% endif %}
          </div>

          <!-- Bloc bas gauche - Arguments check -->
          <div class="lpb-comparison__args-block-{{ section_id }}">
            <ul class="lpb-comparison__list-{{ section_id }}">
              {% for i in (1..8) %}
                {% assign arg_key = 'column1_arg_' | append: i %}
                {% assign arg_value = section.settings[arg_key] %}
                {% if arg_value != blank %}
                  <li class="lpb-comparison__item-{{ section_id }}">
                    <span class="lpb-comparison__icon-{{ section_id }} lpb-comparison__icon--check-{{ section_id }}">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="20" height="20" rx="4" fill="currentColor" fill-opacity="0.15"/>
                        <path d="M14.5 7L8.5 13L5.5 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span>{{ arg_value }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>

          <!-- Bloc bas droit - Arguments croix -->
          <div class="lpb-comparison__args-block-{{ section_id }}">
            <ul class="lpb-comparison__list-{{ section_id }}">
              {% for i in (1..8) %}
                {% assign arg_key = 'column2_arg_' | append: i %}
                {% assign arg_value = section.settings[arg_key] %}
                {% if arg_value != blank %}
                  <li class="lpb-comparison__item-{{ section_id }}">
                    <span class="lpb-comparison__icon-{{ section_id }} lpb-comparison__icon--cross-{{ section_id }}">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="20" height="20" rx="4" fill="currentColor" fill-opacity="0.15"/>
                        <path d="M13 7L7 13M7 7L13 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span>{{ arg_value }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>

        {% if section.settings.button_text != blank and section.settings.button_link != blank %}
          <div class="lpb-comparison__button-wrapper-{{ section_id }}">
            <a href="{{ section.settings.button_link }}" class="lpb-comparison__button-{{ section_id }}">
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
