      "type": "header",
      "content": "Espacement grille desktop"
    },
    {
      "type": "range",
      "id": "grid_row_gap",
      "label": "Espace haut/bas (entre lignes)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "grid_column_gap",
      "label": "Espace gauche/droite (entre colonnes)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Espacement grille mobile"
    },
    {
      "type": "range",
      "id": "grid_row_gap_mobile",
      "label": "Espace haut/bas (entre lignes)",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "grid_column_gap_mobile",
      "label": "Espace gauche/droite (entre colonnes)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale du contenu",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Padding desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding haut",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bas",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_margin",
      "label": "Marge latérale",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Espacement mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding haut",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bas",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_margin_mobile",
      "label": "Marge latérale",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Bordures"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Arrondi des cartes",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "LPB Comparison"
    }
  ]
