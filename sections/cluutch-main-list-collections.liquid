      "label": "t:sections.global.settings.rounded.label"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "t:sections.global.blocks.collection.name",
      "settings": [
        {
          "label": "t:sections.global.settings.collection.label",
          "id": "collection",
