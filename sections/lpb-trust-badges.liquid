{% assign section_id = section.id | replace: '_', '' | downcase %}

{% liquid
  assign base_speed = 110 | minus: section.settings.animation_speed
  assign speed_value = base_speed | divided_by: 2
%}

{% style %}
  .lpb-trust-badges-{{ section_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: transparent;
  }

  {% if section.settings.hide_on_mobile %}
    @media screen and (max-width: 749px) {
      .lpb-trust-badges-{{ section_id }} {
        display: none;
      }
    }
  {% endif %}

  {% if section.settings.hide_on_desktop %}
    @media screen and (min-width: 750px) {
      .lpb-trust-badges-{{ section_id }} {
        display: none;
      }
    }
  {% endif %}

  .lpb-trust-badges-container-{{ section_id }} {
    {% if section.settings.container_width == 'page-width' %}
      max-width: {{ settings.page_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    {% else %}
      width: 100%;
    {% endif %}
  }

  .lpb-trust-badges-track-{{ section_id }} {
    display: flex;
    gap: {{ section.settings.item_spacing }}px;
    will-change: transform;
  }

  {% if section.settings.enable_animation and section.settings.pause_on_hover %}
    .lpb-trust-badges-track-{{ section_id }}:hover {
      animation-play-state: paused;
    }
  {% endif %}

  .lpb-trust-badges-item-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    white-space: nowrap;
    flex-shrink: 0;
    border-radius: {{ section.settings.border_radius }}px;
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: {{ section.settings.text_size_desktop }}px;
    font-weight: 400;
    line-height: 1.4;
    text-decoration: none;
    color: {{ section.settings.text_color }};
    transition: opacity 0.2s ease;

    {% if section.settings.pill_style == 'soft-background' %}
      background-color: {{ section.settings.badge_background }};
      border: none;
    {% elsif section.settings.pill_style == 'outline' %}
      background-color: transparent;
      border: 1px solid {{ section.settings.badge_background }};
    {% else %}
      background-color: transparent;
      border: none;
    {% endif %}
  }

  a.lpb-trust-badges-item-{{ section_id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .lpb-trust-badges-item-{{ section_id }} {
      font-size: {{ section.settings.text_size_mobile }}px;
    }
  }

  .lpb-trust-badges-icon-{{ section_id }} {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
  }

  .lpb-trust-badges-icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .lpb-trust-badges-text-{{ section_id }} {
    color: {{ section.settings.text_color }};
  }
{% endstyle %}

<div class="lpb-trust-badges-{{ section_id }}">
  <div class="lpb-trust-badges-container-{{ section_id }}">
    <div class="lpb-trust-badges-track-{{ section_id }}">
      {% liquid
        assign items_count = 0
        for i in (1..10)
          assign label_key = 'item_' | append: i | append: '_label'
          if section.settings[label_key] != blank
            assign items_count = items_count | plus: 1
          endif
        endfor
      %}

      {% if items_count > 0 %}
        {% for repeat in (1..4) %}
          {% for i in (1..10) %}
            {% liquid
              assign label_key = 'item_' | append: i | append: '_label'
              assign icon_key = 'item_' | append: i | append: '_icon'
              assign custom_svg_key = 'item_' | append: i | append: '_custom_svg'
              assign link_key = 'item_' | append: i | append: '_link'

              assign item_label = section.settings[label_key]
              assign item_icon = section.settings[icon_key]
              assign custom_svg = section.settings[custom_svg_key]
              assign item_link = section.settings[link_key]
            %}

            {% if item_label != blank %}
              {% if item_link != blank %}
                <a href="{{ item_link }}" class="lpb-trust-badges-item-{{ section_id }}">
              {% else %}
                <div class="lpb-trust-badges-item-{{ section_id }}">
              {% endif %}
                {% if custom_svg != blank %}
                  <div class="lpb-trust-badges-icon-{{ section_id }}">
                    {{ custom_svg }}
                  </div>
                {% elsif item_icon != 'none' %}
                  <div class="lpb-trust-badges-icon-{{ section_id }}">
                    {% if item_icon == 'checkmark' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    {% elsif item_icon == 'star' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% elsif item_icon == 'heart' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                      </svg>
                    {% elsif item_icon == 'shield' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      </svg>
                    {% elsif item_icon == 'truck' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                      </svg>
                    {% elsif item_icon == 'leaf' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                        <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                      </svg>
                    {% elsif item_icon == 'award' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="7"></circle>
                        <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                      </svg>
                    {% elsif item_icon == 'gift' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 12 20 22 4 22 4 12"></polyline>
                        <rect x="2" y="7" width="20" height="5"></rect>
                        <line x1="12" y1="22" x2="12" y2="7"></line>
                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                      </svg>
                    {% endif %}
                  </div>
                {% endif %}
                <span class="lpb-trust-badges-text-{{ section_id }}">{{ item_label }}</span>
              {% if item_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% else %}
        {% for repeat in (1..4) %}
          <div class="lpb-trust-badges-item-{{ section_id }}">
            <div class="lpb-trust-badges-icon-{{ section_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <span class="lpb-trust-badges-text-{{ section_id }}">Livraison gratuite</span>
          </div>
          <div class="lpb-trust-badges-item-{{ section_id }}">
            <div class="lpb-trust-badges-icon-{{ section_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            </div>
            <span class="lpb-trust-badges-text-{{ section_id }}">100% naturel</span>
          </div>
          <div class="lpb-trust-badges-item-{{ section_id }}">
            <div class="lpb-trust-badges-icon-{{ section_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <span class="lpb-trust-badges-text-{{ section_id }}">Paiement sécurisé</span>
          </div>
          <div class="lpb-trust-badges-item-{{ section_id }}">
            <div class="lpb-trust-badges-icon-{{ section_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <span class="lpb-trust-badges-text-{{ section_id }}">4.9/5 étoiles</span>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% if section.settings.enable_animation %}
<script>
(function() {
  const track = document.querySelector('.lpb-trust-badges-track-{{ section_id }}');
  if (!track) return;

  const items = track.children;
  const itemCount = items.length;
  const repetitions = 4;
  const oneSetCount = itemCount / repetitions;

  // Calculate width of one complete set of items
  let oneSetWidth = 0;
  const gap = {{ section.settings.item_spacing }};

  for (let i = 0; i < oneSetCount; i++) {
    oneSetWidth += items[i].offsetWidth;
    oneSetWidth += gap;
  }

  // Calculate animation duration based on speed setting
  const speedValue = {{ speed_value }};
  const duration = speedValue;

  // Create keyframes
  const keyframeName = 'lpb-trust-badges-scroll-{{ section_id }}';
  const direction = '{{ section.settings.animation_direction }}';
  const translateValue = direction === 'right' ? oneSetWidth : -oneSetWidth;

  const styleSheet = document.createElement('style');
  styleSheet.textContent = `
    @keyframes ${keyframeName} {
      0% { transform: translateX(0); }
      100% { transform: translateX(${translateValue}px); }
    }
  `;
  document.head.appendChild(styleSheet);

  // Apply animation
  track.style.animation = `${keyframeName} ${duration}s linear infinite`;
})();
</script>
{% endif %}

