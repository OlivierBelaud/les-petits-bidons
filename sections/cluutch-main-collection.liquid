{{ 'cluutch-featured-collections.css' | asset_url | stylesheet_tag }}
{{ 'cluutch-featured-collection.css' | asset_url | stylesheet_tag }}
{{ 'cluutch-main-collection.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;

    @media(min-width:768px){
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>
{% if template.name == 'collection' %}
  <style>
    @media (max-width: 767px) {
      .cluutch-collection-section .cluutch-badges-wrapper {
        flex-direction: row;
        top: 4px;
        left: 4px;
      }
      .product-card__title {
        font-family: Raleway;
        font-size: 12px;
        font-weight: 700;
        line-height: 133.333%;
        letter-spacing: -0.24px;
      }
      .cluutch-price .price__regular {
        font-family: Raleway;
        font-size: 12px;
        font-weight: 700;
        line-height: 133.333%;
        letter-spacing: -0.24px;
      }
      .cluutch-collection-section .button--primary {
        height: 32px;
        margin-top: 0;
      }
      .cluutch-card__content {
        padding: 8px 8px 12px;
      }
      .cluutch-card__media,
      .cluutch-card__media img {
        aspect-ratio: 165/164;
      }
    }
    @media (max-width: 1023px) {
      .cluutch-card .product-card__flex {
        flex-direction: column-reverse;
        gap: 8px;
      }
    }
  </style>
{% endif %}

<script src="{{ 'collection.js' | asset_url }}" defer></script>

{%- liquid
  assign filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.max_value.value != blank or filter.min_value.value != blank
        assign filter_count = filter_count | plus: 1
      endif
    else
      assign filter_count = filter_count | plus: filter.active_values.size
    endif
  endfor

  assign description = section.blocks | where: 'type', 'description' | first
  assign subcollections = section.blocks | where: 'type', 'subcollections' | first

  assign enable_sorting = section.settings.enable_sorting
  assign enable_filtering = section.settings.enable_filtering
  assign filter_type = section.settings.filter_type
-%}

<div
  id="collection-content"
  class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}"
>
  <div class="collection page-width{% if section.settings.full_width %} page-width--full{% endif %} relative{% if enable_filtering %} with-{{ filter_type }}{% endif %}">
    {%- if description != blank and collection.description != blank -%}
      <div class="rte collection__description" {{ description.shopify_attributes }}>
        {{- collection.description -}}
      </div>
    {%- endif -%}

    {% comment %}
      <div class="collection-buttons">
        {%- liquid
          for i in (1..6)
            assign collection_setting = 'collection_' | append: i
            assign collection_handle = section.settings[collection_setting]

            if collection_handle
              assign collection = collections[collection_handle]
              if collection
                echo '<a href="' | append: collection.url | append: '" class="collection-button">'
                echo collection.title
                echo '</a>'
              endif
            endif
          endfor
        -%}
      </div>
    {% endcomment %}

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.all_products_count > 0 -%}
        {%- render 'facets-sticky',
          results: collection,
          collapsed: section.settings.filter_collapsed,
          enable_color_swatches: section.settings.filter_color_swatches,
          enable_filtering: enable_filtering,
          enable_sorting: enable_sorting,
          filter_count: filter_count,
          section_id: section.id
        -%}
      {%- endif -%}

      {%- if enable_filtering or enable_sorting or subcollections != blank -%}
        <div class="collection__topbar hidden xl:flex items-center gap-4">
          {%- if enable_filtering and collection.all_products_count > 0 -%}
            {%- if filter_type == 'drawer' -%}
              {%- render 'facets-drawer',
                results: collection,
                collapsed: section.settings.filter_collapsed,
                enable_filtering: enable_filtering,
                enable_sorting: enable_sorting,
                enable_color_swatches: section.settings.filter_color_swatches,
                filter_count: filter_count,
                section_id: section.id
              -%}
            {%- elsif filter_type == 'sidebar' -%}
              <div class="facet-wrapper">
                <button
                  class="button button--secondary icon-with-text"
                  type="button"
                  is="filters-toogle"
                  aria-controls="FacetFiltersContainer"
                  aria-expanded="true"
                >
                  <span class="btn-fill" data-fill></span>
                  <span class="btn-text">
                    {%- liquid
                      render 'icon', icon: 'filter'
                      echo 'collections.filtering.filter_hide_button' | t
                    -%}
                  </span>
                  <span class="btn-text btn-duplicate">
                    {%- liquid
                      render 'icon', icon: 'filter'
                      echo 'collections.filtering.filter_show_button' | t
                    -%}
                    <facet-count
                      class="count flex items-center justify-center text-xs font-medium rounded-full"
                      {% if filter_count == 0 %}
                        hidden
                      {% endif %}
                    >
                      {{- filter_count -}}
                    </facet-count>
                  </span>
                </button>
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- if subcollections != blank -%}
            {%- render 'subcollections',
              main_menu: subcollections.settings.menu,
              per_row: subcollections.settings.per_row,
              show_count: subcollections.settings.show_count
            -%}
          {%- else -%}
            <p id="ProductCount" class="text-base lg:text-lg" role="status">
              {%- liquid
                if collection.results_count
                  echo 'general.search.results_with_count' | t: terms: collection.terms, count: collection.results_count
                elsif collection.products_count == collection.all_products_count
                  echo 'collections.general.product_count_simple' | t: count: collection.products_count
                else
                  echo 'collections.general.product_count' | t: product_count: collection.products_count, count: collection.all_products_count
                endif
              -%}
            </p>
          {%- endif -%}

          {%- if enable_sorting and collection.all_products_count > 0 -%}
            {%- liquid
              assign sort_by = collection.sort_by | default: collection.default_sort_by
              for option in collection.sort_options
                if option.value == sort_by
                  assign sort_by_name = option.name
                  break
                endif
              endfor
            -%}
            <div class="facet-sorting inline-flex items-center gap-6" id="SortByContainer">
              <span>{{ 'collections.sorting.sort_by_label' | t }}</span>
              <facet-sort class="sort-wrapper relative">
                <hover-element class="button button--secondary sort-by whitespace-nowrap overflow-hidden z-3">
                  <span class="btn-fill" data-fill></span>
                  <div class="btn-text">
                    <span class="sort-header flex items-center justify-center gap-5 relative w-full">
                      <span class="sort-selection">{{ sort_by_name | escape }}</span>
                      <span class="sort-title text-sm uppercase absolute left-0 opacity-0 tracking-widest">
                        {{- 'collections.sorting.sort_button' | t -}}
                      </span>
                      <span class="sort-close flex items-center justify-center rounded-full">
                        {%- render 'icon', icon: 'close', size: 'sm' -%}
                      </span>
                    </span>
                    <ul class="sort-listbox text-left grid gap-2 absolute left-0 opacity-0 invisible w-full h-auto">
                      {%- for option in collection.sort_options -%}
                        <li class="opacity-0 relative">
                          <input
                            id="SortBy-{{ option.value }}"
                            class="sr-only"
                            name="sort_by"
                            type="radio"
                            value="{{ option.value }}"
                            {% if option.value == sort_by %}
                              checked
                            {% endif %}
                          >
                          <label for="SortBy-{{ option.value }}" class="reversed-link text-xl">
                            {{- option.name | escape -}}
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </hover-element>
              </facet-sort>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- liquid
        if enable_filtering
          render 'facets-active', results: collection, enable_color_swatches: section.settings.filter_color_swatches, filter_count: filter_count
        endif
      -%}

      {% comment %}
        <div class="collection-buttons">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' -%}
              {%- assign collection_handle = block.settings.collection_handle -%}
              {%- assign collection = collections[collection_handle] -%}
              {%- if collection -%}
                <a href="{{ collection.url }}" class="collection-button">
                  {{ block.settings.collection_title }}
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {% endcomment %}

      {% comment %}
        {% assign active_collection_handle = collection.handle | default: '' %}

        {% if active_collection_handle == '' %}
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' -%}
              {% assign active_collection_handle = block.settings.collection_handle %}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {% endif %}

        <div class="cluutch-collection-buttons ">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' -%}
              <a class="collection-link" href="/collections/{{ block.settings.collection_handle }}">
                <button class="button cluutch-collection-button cluutch-button--more {% if block.settings.collection_handle == active_collection_handle %}active{% endif %}">
                  <span class="btn-fill"></span>
                  <div id="loading-indicator" style="display: none">
                    <p>loading...</p>
                  </div>
                  <span class="cluutch-button--text">{{ block.settings.collection_title }}</span>
                </button>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {% endcomment %}

      <div class="cluutch-collection-buttons ">
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' -%}
            <a
              class="collection-link"

              href="/collections/{{ block.settings.collection_handle }}"
            >
              <button class="button cluutch-collection-button cluutch-button--more {% if block.settings.collection_handle == collection.handle %}active{% endif %}">
                <span class="btn-fill"></span>
                <div id="loading-indicator" style="display: none">
                  <p>loading...</p>
                </div>

                <span class="cluutch-button--text">{{ block.settings.collection_title }}</span>
              </button>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="collection__content flex">
        {%- if enable_filtering and filter_type == 'sidebar' and collection.all_products_count > 0 -%}
          <div class="hidden xl:block" id="FacetFiltersContainer">
            <sticky-element class="facets__scroll block sticky top-0">
              {%- render 'facets',
                context: 'sidebar',
                results: collection,
                collapsed: section.settings.filter_collapsed,
                enable_filtering: enable_filtering,
                enable_sorting: false,
                enable_color_swatches: section.settings.filter_color_swatches,
                section_id: section.id
              -%}
            </sticky-element>
          </div>
        {%- endif -%}

        <div class="flex flex-col gap-12 grow" id="ProductGridContainer">
          {% comment %}
            {%- if collection.products.size == 0 -%}
              <div class="empty-state grid items-center justify-center text-center gap-7d5">
                {%- if collection.all_products_count > 0 -%}
                  <div class="flex flex-col items-center gap-3">
                    {%- render 'icon', icon: 'empty', size: 'xxxl' -%}
                    <p class="heading leading-none tracking-tight">{{ 'collections.general.no_results' | t }}</p>
                    <p>{{ 'collections.general.use_fewer_filters' | t }}</p>
                  </div>
                  <a
                    class="button button--primary icon-with-text"
                    href="{{ collection.url }}"
                    is="facet-remove"
                    data-magnet="0"
                  >
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">
                      {%- liquid
                        render 'icon', icon: 'close-2', size: 'xxxs'
                        echo 'collections.filtering.clear_all' | t
                      -%}
                    </span>
                  </a>
                {%- else -%}
                  <div class="flex flex-col items-center gap-3">
                    {%- render 'icon', icon: 'empty', size: 'xxxl' -%}
                    <p class="heading leading-none tracking-tight">{{ 'collections.general.empty' | t }}</p>
                  </div>
                  <a
                    class="button button--primary icon-with-text"
                    href="{{ routes.all_products_collection_url }}"
                    is="hover-link"
                  >
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">{{ 'collections.general.continue_shopping' | t }}</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {% endcomment %}

          {%- if collection.all_products_count > 0 -%}
            <motion-list class="card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid relative">
              {%- for product in collection.products -%}
                {%- liquid
                  for block in section.blocks
                    if block.type == 'promotion' or block.type == 'promotion_video'
                      if forloop.parentloop.index != block.settings.position
                        continue
                      endif

                      assign show_promotion = false
                      if block.settings.collections == empty
                        assign show_promotion = true
                      else
                        assign collection_handles = block.settings.collections | map: 'handle'
                        if collection_handles contains collection.handle
                          assign show_promotion = true
                        endif
                      endif

                      if show_promotion
                        render 'promotion-card', block: block
                      endif
                    endif
                  endfor

                  assign lazy_load = false
                  if forloop.index > 2
                    assign lazy_load = true
                  endif
                -%}
                {% if product.tags contains 'new' %}
                  {%- if product.variants.size == 0 -%}
                    {% comment %}
                      {% if collection.handle == 'bebe-les-petits-bidons' %}
                        {% for variant in product.variants %}
                          {% if variant.title contains 'Bébé' %}
                            {%- render 'cluutch-product-card',
                              product: product,
                              product_id: product.id,
                              section_id: section.id,
                              lazy_load: lazy_load,
                              image_ratio: settings.product_image_ratio,
                              image_fill: settings.product_image_fill,
                              show_secondary_image: settings.product_secondary_image,
                              show_vendor: settings.product_vendor,
                              show_rating: settings.product_rating,
                              show_color_swatches: settings.product_color_swatches,
                              show_countdown: settings.product_countdown,
                              show_quick_add: settings.product_quick_add,
                              show_quick_view: settings.product_quick_view,
                              show_save_amount: settings.product_save_amount,
                              save_type: settings.product_save_type
                            -%}
                          {% endif %}
                        {% endfor %}
                      {% elsif collection.handle == 'sport-les-petits-bidons' %}
                        {% for variant in product.variants %}
                          {% if variant.title contains 'Eucalyptus' %}
                            {%- render 'cluutch-product-card',
                              product: product,
                              product_id: product.id,
                              section_id: section.id,
                              lazy_load: lazy_load,
                              image_ratio: settings.product_image_ratio,
                              image_fill: settings.product_image_fill,
                              show_secondary_image: settings.product_secondary_image,
                              show_vendor: settings.product_vendor,
                              show_rating: settings.product_rating,
                              show_color_swatches: settings.product_color_swatches,
                              show_countdown: settings.product_countdown,
                              show_quick_add: settings.product_quick_add,
                              show_quick_view: settings.product_quick_view,
                              show_save_amount: settings.product_save_amount,
                              save_type: settings.product_save_type
                            -%}
                          {% endif %}
                        {% endfor %}

                      {% else %}
                        {%- render 'cluutch-product-card',
                          product: product,
                          product_id: product.id,
                          section_id: section.id,
                          lazy_load: lazy_load,
                          image_ratio: settings.product_image_ratio,
                          image_fill: settings.product_image_fill,
                          show_secondary_image: settings.product_secondary_image,
                          show_vendor: settings.product_vendor,
                          show_rating: settings.product_rating,
                          show_color_swatches: settings.product_color_swatches,
                          show_countdown: settings.product_countdown,
                          show_quick_add: settings.product_quick_add,
                          show_quick_view: settings.product_quick_view,
                          show_save_amount: settings.product_save_amount,
                          save_type: settings.product_save_type
                        -%}
                      {% endif %}
                    {% endcomment %}
                  {% else %}
                    {%- liquid
                      assign rating_max = 5
                      if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0
                        assign rating_value = product.metafields.reviews.rating.value.rating | round: 1
                        assign rating_count = product.metafields.reviews.rating_count.value
                        assign rating_max = product.metafields.reviews.rating.value.scale_max
                      elsif show_empty
                        assign rating_value = 0.0
                        assign rating_count = 0
                      elsif show_placeholder
                        assign rating_value = 4.5
                        assign rating_count = 2
                      else
                        assign hide_rating = true
                      endif
                    -%}

                    {% if collection.handle == 'bebe-les-petits-bidons' %}
                      {%- for variant in product.variants -%}
                        {% if variant.title contains 'Bébé'
                          or variant.metafields.custom.collection_category contains 'Bébé'
                        %}
                          <div class="card cluutch-card product-card product-card--card flex flex-col leading-none relative overflow-hidden">
                            <div class="product-card__media cluutch-card__media relative h-auto overflow-hidden">
                              <a
                                href="{{ variant.url }}"
                                class="block relative media media--adapt media--contain overflow-hidden"
                              >
                                {% if variant.image %}
                                  {{
                                    variant.image
                                    | image_url: width: master
                                    | image_tag: loading: 'lazy', alt: variant.title, class: 'variant-image__img'
                                  }}
                                {% else %}
                                  {{
                                    product.featured_image
                                    | image_url: width: master
                                    | image_tag: loading: 'lazy', alt: product.title, class: 'variant-image__img'
                                  }}
                                {% endif %}
                              </a>

                              <div class="cluutch-badges-wrapper">
                                {% if product.metafields.theme.label.value != blank and product.metafields.theme.label_color.value != blank %}
                                  {%- for label in product.metafields.theme.label.value -%}
                                    <p class="cluutch-badge" style="background: {{ product.metafields.theme.label_color.value }}; color: #ffffff;">
                                      {{ label | escape }}
                                    </p>
                                  {%- endfor -%}
                                {% else %}
                                  {% if variant.metafields.custom.cluutch_meilleure != blank %}
                                    <p class="cluutch-badge cluutch-badge--yellow">
                                      {{ variant.metafields.custom.cluutch_meilleure }}
                                    </p>
                                  {% endif %}
                                  {% if variant.metafields.custom.cluutch_sans != blank %}
                                    <p class="cluutch-badge cluutch-badge--blue">
                                      {{ variant.metafields.custom.cluutch_sans }}
                                    </p>
                                  {% endif %}
                                  {% if variant.metafields.custom.cluutch_lavande != blank %}
                                    <p class="cluutch-badge cluutch-badge--blue-lava">
                                      {{ variant.metafields.custom.cluutch_lavande }}
                                    </p>
                                  {% endif %}
                                  {% if variant.metafields.custom.cluutch_fleurs != blank %}
                                    <p class="cluutch-badge cluutch-badge--orange">
                                      {{ variant.metafields.custom.cluutch_fleurs }}
                                    </p>
                                  {% endif %}
                                  {% if variant.metafields.custom.cluutch_eucalyptus != blank %}
                                    <p class="cluutch-badge cluutch-badge--mint">
                                      {{ variant.metafields.custom.cluutch_eucalyptus }}
                                    </p>
                                  {% endif %}
                                {% endif %}
                              </div>
                            </div>

                            <div class="product-card__content cluutch-card__content grow flex flex-col justify-start text-left">
                              <div
                                class="product-card__details cluutch-card__details flex flex-col  items-baseline gap-2 w-full"
                              >
                                <div class="product-card__flex">
                                  <p class="grow cluutch-grow">
                                    <a
                                      class="product-card__title reversed-link text-base-xl font-medium leading-tight"
                                      href="{{ variant.url }}"
                                    >
                                      {{- variant.metafields.custom.cluutch_variant_title -}}
                                    </a>
                                  </p>

                                  <div
                                    class="rating cluutch-rating product-card__rating rounded-full flex items-center gap-2 md:gap-1d5 pointer-events-none"
                                    title="{{ 'general.accessibility.star_reviews_count' | t: count: rating_count | escape }}"
                                  >
                                    <span
                                      role="img"
                                      aria-label="{{ 'general.accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max }}"
                                    >
                                      {%- render 'cluutch-icon', icon: 'star' -%}
                                    </span>
                                    <p>{{ rating_value }}</p>
                                    <p>({{ rating_count }})</p>
                                  </div>
                                </div>

                                <div class="price flex flex-wrap  gap-2 md:gap-1d5 cluutch-price">
                                  {% if variant.compare_at_price > variant.price %}
                                    <span class="price--sale">{{ variant.price | money }}</span>
                                    <span class="price--compare"
                                      ><del>{{ variant.compare_at_price | money }}</del></span
                                    >
                                  {% else %}
                                    <span class="price__regular whitespace-nowrap">{{ variant.price | money }}</span>
                                  {% endif %}
                                </div>
                                <div class="quick-add flex justify-end md:justify-center w-full z-1 pointer-events-none">
                                  {%- form 'product', product, is: 'product-form', id: product_form_id -%}
                                    <input type="hidden" name="id" value="{{ variant.id }}">
                                    {%- liquid
                                      if product.template_suffix != 'pre-order'
                                        assign quick_add_label = 'products.product.add_to_cart' | t
                                      else
                                        assign quick_add_label = 'products.product.pre_order' | t
                                      endif
                                    -%}
                                    <button
                                      type="submit"
                                      class="button button--primary pointer-events-auto "
                                      is="hover-button"
                                      data-variant-id="{{ variant.id }}"
                                      aria-label="{{ quick_add_label | escape }}"
                                      {% unless variant.available %}
                                        disabled="disabled"
                                      {% endunless %}
                                    >
                                      <span class="btn-fill" data-fill></span>
                                      <span class="btn-text">
                                        {% comment %} {%- render 'icon', icon: 'cart', size: 'sm', class: 'md:hidden' -%} {% endcomment %}
                                        {% if template.name == 'collection' %}
                                          <span
                                            class=" hidden md:block"
                                            data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
                                          >
                                            {% if variant.available %}
                                              {{- quick_add_label -}}
                                            {% else %}
                                              {{ 'products.product.sold_out' | t }}
                                            {% endif %}
                                          </span>
                                          <span
                                            class="block  md:hidden"
                                            data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
                                          >
                                            {% if variant.available %}
                                              Ajouter
                                            {% else %}
                                              {{ 'products.product.sold_out_short' | t }}
                                            {% endif %}
                                          </span>
                                        {% else %}
                                          <span
                                            class="block"
                                            data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
                                          >
                                            {{- quick_add_label -}}
                                          </span>
                                        {% endif %}
                                      </span>
                                    </button>
                                  {%- endform -%}
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endif %}
                      {%- endfor -%}

                    {% elsif collection.handle == 'sport-les-petits-bidons' %}
                      {%- for variant in product.variants -%}
                        {% if variant.title contains 'Eucalyptus'
                          or variant.metafields.custom.collection_category contains 'Sport'
                        %}
                          <div class="card cluutch-card product-card product-card--card flex flex-col leading-none relative overflow-hidden">
                            <div class="product-card__media cluutch-card__media relative h-auto overflow-hidden">
                              <a
                                href="{{ variant.url }}"
                                class="block relative media media--adapt media--contain overflow-hidden"
                              >
                                {% if variant.image %}
                                  {{
                                    variant.image
