                                  </p>
                                {% endif %}
                                {% if variant.metafields.custom.cluutch_sans != blank %}
                                  <p class="cluutch-badge cluutch-badge--blue">
                                    {{ variant.metafields.custom.cluutch_sans }}
                                  </p>
                                {% endif %}
                                {% if variant.metafields.custom.cluutch_lavande != blank %}
                                  <p class="cluutch-badge cluutch-badge--blue-lava">
                                    {{ variant.metafields.custom.cluutch_lavande }}
                                  </p>
                                {% endif %}
                                {% if variant.metafields.custom.cluutch_fleurs != blank %}
