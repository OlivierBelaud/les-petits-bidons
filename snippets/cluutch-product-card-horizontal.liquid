{%- comment -%}
  Renders a horizontal product card for cart recommendations.

  Accepts:
  - product: {Object} The item to render
  - image_ratio, image_fill, show_vendor, show_price, show_quick_add, show_quick_view (legacy params, kept for compatibility)

  Usage:
  {% render 'cluutch-product-card-horizontal', product: item %}
{%- endcomment -%}

{%- liquid
  assign variant_label = ''
  unless product.has_only_default_variant
    assign variant_label = product.selected_or_first_available_variant.title
  endunless

  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign has_rating = false
  if rating_value != blank and rating_count > 0
    assign has_rating = true
    assign rating_clean = rating_value | replace: ',', '.' | replace: ' ', '' | plus: 0 | round: 1
  endif
-%}

<div class="horizontal-product cluutch-reco-card">
  <a class="cluutch-reco-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '86,172,258', class: 'cluutch-reco-card__img', alt: '', width: 86, height: 86 }}
    {%- else -%}
      <span class="cluutch-reco-card__img-placeholder">{{ 'image' | placeholder_svg_tag: 'cluutch-reco-card__img placeholder-svg' }}</span>
    {%- endif -%}
  </a>
  <div class="cluutch-reco-card__body">
    {%- if has_rating -%}
      <div class="cluutch-reco-card__rating">
        {% render 'cluutch-icon', icon: 'star' %}
        <span class="cluutch-reco-card__rating-value">{{ rating_clean }}/5</span>
        <span class="cluutch-reco-card__rating-count">({{ rating_count }})</span>
      </div>
    {%- endif -%}
    <a href="{{ product.url }}" class="cluutch-reco-card__title">
      {{- product.title | escape -}}
    </a>
    {%- if variant_label != '' -%}
      <p class="cluutch-reco-card__variant">{{ variant_label }}</p>
    {%- endif -%}
    <div class="cluutch-reco-card__footer">
      <span class="cluutch-reco-card__price">
        {%- if product.price_varies -%}
          {{ product.price_min | money }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </span>
      {%- if product.available -%}
        {%- if product.variants.size == 1 -%}
          {%- form 'product', product, is: 'product-form', class: 'cluutch-reco-card__form' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="cluutch-reco-card__btn" aria-label="{{ 'products.product.quick_add' | t | escape }}">
              + Ajouter
            </button>
          {%- endform -%}
        {%- else -%}
          <a href="{{ product.url }}" class="cluutch-reco-card__btn" aria-label="{{ 'products.product.quick_view' | t | escape }}">
            + Ajouter
          </a>
        {%- endif -%}
      {%- else -%}
        <span class="cluutch-reco-card__btn cluutch-reco-card__btn--disabled">
          {{- 'products.product.sold_out' | t -}}
        </span>
      {%- endif -%}
    </div>
  </div>
</div>
