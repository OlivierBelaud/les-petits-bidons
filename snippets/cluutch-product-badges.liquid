{%- liquid
  if product.compare_at_price > product.price and show_save_amount
    if save_type == 'label'
      assign saved_amount = save_type
    elsif save_type == 'dollar'
      assign saved_amount = product.compare_at_price | minus: product.price | money
    else
      assign saved_amount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
      assign saved_amount = saved_amount | append: '%'
    endif
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign badge_texte = current_variant.metafields.custom.label_texte
  assign badge_color = current_variant.metafields.custom.label_color
  if badge_texte == blank or badge_color == blank
    assign badge_texte = product.metafields.custom.label_texte
    assign badge_color = product.metafields.custom.label_color
  endif
-%}

<!-- DEBUG VARIANT -->
<div style="background:red;color:white;padding:5px;font-size:10px;z-index:9999;position:relative;">
  variant_id: {{ current_variant.id }}<br>
  variant_title: {{ current_variant.title }}<br>
  variant_label_texte: [{{ current_variant.metafields.custom.label_texte }}]<br>
  variant_label_color: [{{ current_variant.metafields.custom.label_color }}]<br>
  product_label_texte: [{{ product.metafields.custom.label_texte }}]<br>
  product_label_color: [{{ product.metafields.custom.label_color }}]<br>
  badge_texte: [{{ badge_texte }}]<br>
  badge_color: [{{ badge_color }}]
</div>
<!-- FIN DEBUG -->
<div class="cluutch-badges-wrapper">
  {% if badge_texte != blank and badge_color != blank %}
    <p class="cluutch-badge" style="background: {{ badge_color }}; color: #ffffff;">
      {{ badge_texte | escape }}
    </p>
  {% else %}
    {% if product.metafields.custom.cluutch_meilleure != blank %}
      <p class="cluutch-badge cluutch-badge--yellow">
        {{ product.metafields.custom.cluutch_meilleure }}
      </p>
    {% endif %}
    {% if product.metafields.custom.cluutch_sans != blank %}
      <p class="cluutch-badge cluutch-badge--blue">
        {{ product.metafields.custom.cluutch_sans }}
      </p>
    {% endif %}
    {% if product.metafields.custom.cluutch_lavande != blank %}
      <p class="cluutch-badge cluutch-badge--blue-lava">
        {{ product.metafields.custom.cluutch_lavande }}
      </p>
    {% endif %}
    {% if product.metafields.custom.cluutch_fleurs != blank %}
      <p class="cluutch-badge cluutch-badge--orange">
        {{ product.metafields.custom.cluutch_fleurs }}
      </p>
    {% endif %}
    {% if product.metafields.custom.cluutch_eucalyptus != blank %}
      <p class="cluutch-badge cluutch-badge--mint">
        {{ product.metafields.custom.cluutch_eucalyptus }}
      </p>
    {% endif %}
  {% endif %}
</div>

{% comment %}
  <div class="badges{% if class != blank %} {{ class }}{% endif %} pointer-events-none">
    {%- if product.metafields.theme.label.value != blank -%}
      {%- capture styles -%}
        {%- if product.metafields.theme.label_color.value != blank -%}
          --badge-background: {{ product.metafields.theme.label_color.value }}; --badge-foreground: #ffffff;
        {%- endif -%}
      {%- endcapture -%}
      {%- for label in product.metafields.theme.label.value -%}
        <span
          class="badge flex items-center gap-1d5 font-medium leading-none rounded-full"
          {% if styles != blank %}
            style="{{ styles }}"
          {% endif %}
        >
          {{- label | escape -}}
        </span>
      {%- endfor -%}
    {%- endif -%}

    {%- if saved_amount != blank -%}
      <span class="badge badge--onsale flex items-center gap-1d5 font-medium leading-none rounded-full">
        {%- liquid
          if save_type == 'label'
            echo 'products.general.sale' | t
          else
            echo 'products.general.save_html' | t: saved_amount: saved_amount
          endif
        -%}
      </span>
    {%- endif -%}
  </div>
{% endcomment %}

