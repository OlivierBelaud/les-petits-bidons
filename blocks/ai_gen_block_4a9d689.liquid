<script>
  (function() {
    class AiTrustBadges{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-trust-badges-track-{{ ai_gen_id }}');
      }
    }

    customElements.define('ai-trust-badges-{{ ai_gen_id }}', AiTrustBadges{{ ai_gen_id }});
  })();
</script>

