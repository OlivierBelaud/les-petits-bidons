{% doc %}
  @prompt
    Please create a custom Shopify Liquid section for a "Features" layout using the Raleway font throughout. The section must allow up to 6 blocks, each containing a text field with an adjustable font-size slider and an optional image picker for a PNG or SVG icon. The design should automatically adapt its layout based on whether an icon is present or not. On desktop, the blocks should be arranged in a grid, but on mobile, they must stack vertically, appearing one below the other., Add the option to add svg in addition to an image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-features-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-feature-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.alignment }};
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-feature-icon-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.icon_spacing }}px;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-svg-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-svg-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.svg_color }};
  }

  .ai-feature-text-1-{{ ai_gen_id }} {
    font-family: 'Raleway', sans-serif;
    font-size: {{ block.settings.text_size_1 }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-feature-text-2-{{ ai_gen_id }} {
    font-family: 'Raleway', sans-serif;
    font-size: {{ block.settings.text_size_2 }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-feature-text-3-{{ ai_gen_id }} {
    font-family: 'Raleway', sans-serif;
    font-size: {{ block.settings.text_size_3 }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-feature-text-4-{{ ai_gen_id }} {
    font-family: 'Raleway', sans-serif;
    font-size: {{ block.settings.text_size_4 }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-feature-text-5-{{ ai_gen_id }} {
    font-family: 'Raleway', sans-serif;
    font-size: {{ block.settings.text_size_5 }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-feature-text-6-{{ ai_gen_id }} {
    font-family: 'Raleway', sans-serif;
    font-size: {{ block.settings.text_size_6 }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-features-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-features-block-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-feature-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.8 }}px;
    }

    .ai-feature-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<ai-features-{{ ai_gen_id }} class="ai-features-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-container-{{ ai_gen_id }}">
    <div class="ai-features-grid-{{ ai_gen_id }}">
      {% if block.settings.text_1 != blank or block.settings.icon_1 != blank or block.settings.svg_code_1 != blank %}
        <div class="ai-feature-item-{{ ai_gen_id }}">
          {% if block.settings.svg_code_1 != blank %}
            <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
              <div class="ai-feature-svg-{{ ai_gen_id }}">
                {{ block.settings.svg_code_1 }}
              </div>
            </div>
          {% elsif block.settings.icon_1 != blank %}
            <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.icon_1 | image_url: width: 200 }}"
                alt="{{ block.settings.icon_1.alt | escape }}"
                class="ai-feature-icon-{{ ai_gen_id }}"
                loading="lazy"
                width="200"
                height="200"
              >
            </div>
          {% endif %}
          {% if block.settings.text_1 != blank %}
            <p class="ai-feature-text-1-{{ ai_gen_id }}">
              {{ block.settings.text_1 }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.text_2 != blank or block.settings.icon_2 != blank or block.settings.svg_code_2 != blank %}
