              {{ block.settings.text_3 }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.text_4 != blank or block.settings.icon_4 != blank or block.settings.svg_code_4 != blank %}
        <div class="ai-feature-item-{{ ai_gen_id }}">
          {% if block.settings.svg_code_4 != blank %}
            <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
              <div class="ai-feature-svg-{{ ai_gen_id }}">
                {{ block.settings.svg_code_4 }}
              </div>
            </div>
          {% elsif block.settings.icon_4 != blank %}
            <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.icon_4 | image_url: width: 200 }}"
                alt="{{ block.settings.icon_4.alt | escape }}"
                class="ai-feature-icon-{{ ai_gen_id }}"
                loading="lazy"
                width="200"
                height="200"
              >
            </div>
          {% endif %}
          {% if block.settings.text_4 != blank %}
            <p class="ai-feature-text-4-{{ ai_gen_id }}">
              {{ block.settings.text_4 }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.text_5 != blank or block.settings.icon_5 != blank or block.settings.svg_code_5 != blank %}
        <div class="ai-feature-item-{{ ai_gen_id }}">
          {% if block.settings.svg_code_5 != blank %}
            <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
              <div class="ai-feature-svg-{{ ai_gen_id }}">
                {{ block.settings.svg_code_5 }}
