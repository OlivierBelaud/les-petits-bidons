                alt="{{ block.settings.icon_2.alt | escape }}"
                class="ai-feature-icon-{{ ai_gen_id }}"
                loading="lazy"
                width="200"
                height="200"
              >
            </div>
          {% endif %}
          {% if block.settings.text_2 != blank %}
            <p class="ai-feature-text-2-{{ ai_gen_id }}">
              {{ block.settings.text_2 }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.text_3 != blank or block.settings.icon_3 != blank or block.settings.svg_code_3 != blank %}
