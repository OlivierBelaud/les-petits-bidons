{% doc %}
  @prompt
    Create a card-based content section composed of multiple small cards displayed in a horizontal row.
    On desktop, cards are shown side by side. On mobile, the section becomes horizontally scrollable (swipe).
    
    Each card is made of two stacked parts:
    
    Top area: an image block (full width of the card)
    
    Bottom area: a white content block containing text
    
    Cards have rounded corners, a soft, modern look, and a clear separation between image and text.
    
    The text area includes:
    
    A title and a subtitle, using DM Sans
    
    Controls to customize text content, font size, and font weight
    
    Option to change the font family if needed
    
    In the section settings, we need:
    
    Ability to add, remove, and reorder cards
    
    Image upload per card
    
    Title and subtitle fields per card
    
    Typography controls (font family, size, weight)
    
    Spacing controls (padding inside the text area)
    
    Border radius control for the cards
    
    Option to adjust card width and gap between cards
    
    Mobile behaviour: horizontal scroll with swipe
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-card-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.section_background_color }};
  }

  .ai-card-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-card-section__wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
  }

  .ai-card-section__wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-card-section__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: #ffffff;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-card-section__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .ai-card-section__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-card-section__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-card-section__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-card-section__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-card-section__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    background-color: #ffffff;
  }

  .ai-card-section__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_font_size }}px;
    line-height: 1.3;
    color: {{ block.settings.title_color }};
  }

  .ai-card-section__subtitle-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ block.settings.subtitle_font.family }}, {{ block.settings.subtitle_font.fallback_families }};
    font-weight: {{ block.settings.subtitle_font.weight }};
    font-size: {{ block.settings.subtitle_font_size }}px;
    line-height: 1.5;
    color: {{ block.settings.subtitle_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-card-section__card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}px;
    }

    .ai-card-section__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-card-section__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_font_size | times: 0.9 }}px;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-card-section__wrapper-{{ ai_gen_id }} {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }
{% endstyle %}

<horizontal-card-section-{{ ai_gen_id }}
  class="ai-card-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-card-section__container-{{ ai_gen_id }}">
    <div class="ai-card-section__wrapper-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_subtitle_key = 'card_' | append: i | append: '_subtitle'

          assign card_enabled = block.settings[card_enabled_key]
          assign card_image = block.settings[card_image_key]
          assign card_title = block.settings[card_title_key]
          assign card_subtitle = block.settings[card_subtitle_key]
        %}

        {% if card_enabled %}
          <div class="ai-card-section__card-{{ ai_gen_id }}">
            <div class="ai-card-section__image-wrapper-{{ ai_gen_id }}">
              {% if card_image %}
                <img
                  src="{{ card_image | image_url: width: 800 }}"
                  alt="{{ card_image.alt | escape }}"
                  loading="lazy"
                  width="{{ card_image.width }}"
                  height="{{ card_image.height }}"
                  class="ai-card-section__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-card-section__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-card-section__content-{{ ai_gen_id }}">
              {% if card_title != blank %}
                <h3 class="ai-card-section__title-{{ ai_gen_id }}">{{ card_title }}</h3>
              {% endif %}

              {% if card_subtitle != blank %}
                <p class="ai-card-section__subtitle-{{ ai_gen_id }}">{{ card_subtitle }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</horizontal-card-section-{{ ai_gen_id }}>

<script>
  (function() {
    class HorizontalCardSection{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-card-section__wrapper-{{ ai_gen_id }}');
        this.setupTouchScroll();
      }

      setupTouchScroll() {
        if (!this.wrapper) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.wrapper.addEventListener('mousedown', (e) => {
          if (window.innerWidth >= 750) return;
          isDown = true;
          this.wrapper.style.cursor = 'grabbing';
          startX = e.pageX - this.wrapper.offsetLeft;
          scrollLeft = this.wrapper.scrollLeft;
        });

        this.wrapper.addEventListener('mouseleave', () => {
          isDown = false;
          this.wrapper.style.cursor = 'grab';
        });

        this.wrapper.addEventListener('mouseup', () => {
          isDown = false;
          this.wrapper.style.cursor = 'grab';
        });

        this.wrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.wrapper.offsetLeft;
          const walk = (x - startX) * 2;
          this.wrapper.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('horizontal-card-section-{{ ai_gen_id }}', HorizontalCardSection{{ai_gen_id}});
  })();
</script>

